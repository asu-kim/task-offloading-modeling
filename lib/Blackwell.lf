target Python

reactor Blackwell {
    state execution_time = [3, 5]
    state task_queue = []
    input tasks_to_run
    input in_port
    input recv_a6000
    input recv_agx
    logical action end_execution
    output send_a6000
    output send_agx
    output out_port

    reaction(tasks_to_run) {=
        # Receive the tasks to run and set state variable
        self.task_queue = tasks_to_run.value
        print(self.task_queue)
    =}

    reaction(tasks_to_run, recv_a6000, recv_agx) {=
        # if not task_name.is_present or not input_data.is_present:
        #     sys.stderr.write("ERROR: Both should be present.\n")
        #     exit(1)
    =}

    reaction(in_port) -> end_execution {=
        exec_time = self.execution_time[task_to_run.value]
        end_execution.schedule(MSEC(time_elapsing))
    =}

    reaction(end_execution) -> send_agx, send_a6000, out_port {=
    =}
}