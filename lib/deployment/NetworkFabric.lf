target Python

preamble {=
    from pathlib import Path
=}

reactor NetworkFabric {
    // network packet format: [destination, payload size]
    input in_port0
    input in_port1
    input in_port2
    logical action out_port0_trigger
    logical action out_port1_trigger
    logical action out_port2_trigger
    output out_port0
    output out_port1
    output out_port2

    state num_devices = 3
    state bandwidth
    state devices
    state pending_packet  # Store packet temporarily for routing

    reaction(startup) {=
        bandwidth_csv_path = str(Path(__file__).resolve().parents[2] / "Bandwidth.csv")

        self.devices = [Device() for _ in range(self.num_devices)]
        self.bandwidth = [[0] * self.num_devices for _ in range(self.num_devices)]
        self.pending_packet = None

        # Load bandwidths from CSV
        # Read with pandas and strip whitespace from column names
        comm_df = pd.read_csv(bandwidth_csv_path, index_col=0)
        # Strip whitespace from both column names and index names
        comm_df.columns = comm_df.columns.str.strip()
        comm_df.index = comm_df.index.str.strip()
        
        # Get device names from CSV columns
        csv_device_names = list(comm_df.columns)
        csv_index_names = list(comm_df.index)
        
        # Verify that CSV has the correct number of devices
        if len(csv_device_names) != self.num_devices:
            sys.exit(f"Error: Bandwidth CSV has {len(csv_device_names)} devices, but num_devices={self.num_devices}")
        if len(csv_index_names) != self.num_devices:
            sys.exit(f"Error: Bandwidth CSV index has {len(csv_index_names)} devices, but num_devices={self.num_devices}")
        
        # Verify that column names and index names match (they should for a symmetric bandwidth matrix)
        if csv_device_names != csv_index_names:
            sys.exit(f"Error: Bandwidth CSV column names and index names do not match. Columns: {csv_device_names}, Index: {csv_index_names}")
        
        # Assign device names from CSV columns (in order, preserves duplicates)
        for i, device in enumerate(self.devices):
            device.name = csv_device_names[i]
            device.index = i
        
        # Populate bandwidth matrix directly from CSV
        # Access by position using .values to avoid issues with duplicate column/index names
        # Since CSV rows are in the same order as devices, use device index directly as row index
        comm_values = comm_df.values  # Get numpy array
        for i, device in enumerate(self.devices):
            device_name = device.name
            # Verify the device name matches the CSV row (for validation)
            csv_row_name = comm_df.index[i]
            if csv_row_name != device_name:
                sys.exit(f"Error: Device name mismatch at index {i}. Expected {device_name}, found {csv_row_name} in CSV.")
            
            # Use device index directly as row index (CSV rows are in device order)
            row_idx = i
            
            for j, target_device in enumerate(self.devices):
                # Access by position using numpy array
                value = comm_values[row_idx, j]
                # Check if value is NaN (numpy.nan)
                if pd.isna(value) or (isinstance(value, float) and (value != value)):  # NaN check: value != value
                    sys.exit("Error: No NA is expected.")
                else:
                    self.bandwidth[i][j] = int(value)
        print("In Network Febric, bandwidth:")
        print(self.bandwidth)
    =}

    reaction(in_port0, in_port1, in_port2) -> out_port0_trigger, out_port1_trigger, out_port2_trigger{=
        # Determine which input port received the message and route to appropriate output
        packet = None
        source_port = None
        
        if in_port0.is_present:
            packet = in_port0.value
            source_port = 0
        elif in_port1.is_present:
            packet = in_port1.value
            source_port = 1
        elif in_port2.is_present:
            packet = in_port2.value
            source_port = 2
        
        if packet is None:
            return
        
        # Store packet in state for output reactions
        self.pending_packet = packet
        
        # Extract destination device from packet
        if isinstance(packet, dict) and "destination_device" in packet:
            destination_device = packet["destination_device"]
            
            # Route to the appropriate output port based on destination device index
            # Device 0 = Jetson (out_port0), Device 1 = A6000 (out_port1), Device 2 = Blackwell (out_port2)
            if destination_device == 0:
                print(f"NetworkFabric: Routing packet from device {source_port} to device 0 (Jetson)")
                out_port0_trigger.schedule(0)
            elif destination_device == 1:
                print(f"NetworkFabric: Routing packet from device {source_port} to device 1 (A6000)")
                out_port1_trigger.schedule(0)
            elif destination_device == 2:
                print(f"NetworkFabric: Routing packet from device {source_port} to device 2 (Blackwell)")
                out_port2_trigger.schedule(0)
            else:
                print(f"NetworkFabric: Error - Invalid destination device {destination_device}")
        else:
            print(f"NetworkFabric: Error - Invalid packet format")
    =}

    reaction(out_port0_trigger) -> out_port0 {=
        # Forward the stored packet
        if self.pending_packet is not None:
            out_port0.set(self.pending_packet)
            self.pending_packet = None
    =}
    reaction(out_port1_trigger) -> out_port1 {=
        # Forward the stored packet
        if self.pending_packet is not None:
            out_port1.set(self.pending_packet)
            self.pending_packet = None
    =}
    reaction(out_port2_trigger) -> out_port2 {=
        # Forward the stored packet
        if self.pending_packet is not None:
            out_port2.set(self.pending_packet)
            self.pending_packet = None
    =}
}
