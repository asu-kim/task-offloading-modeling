target Python

preamble {=
    import threading
    import time

    time_unit = 1

    def _apply_network_info(reactor, info):
        if not isinstance(info, dict):
            return
        reactor.bandwidth = info.get("bandwidth", [])
        reactor.latency = info.get("latency", [])

    def _network_receiver_delay_ms(reactor, packet):
        if not isinstance(packet, dict):
            return 0

        sender_device = packet.get("sender_device")
        receiver_device = reactor.receiver_device_index
        payload_size = packet.get("payload_size", 0)

        latency_ms = 0
        bandwidth = 0
        try:
            if sender_device is not None:
                latency_ms = reactor.latency[sender_device][receiver_device]
                bandwidth = reactor.bandwidth[sender_device][receiver_device]
        except (IndexError, TypeError):
            latency_ms = 0
            bandwidth = 0

        transfer_ms = transfer_time_ms(payload_size, bandwidth) if bandwidth > 0 else 0
        return int(latency_ms) + int(transfer_ms)

    def _queue_network_receiver_packet(reactor, source_name, packet, delay_action):
        global network_available_sec
        try:
            network_available_sec
        except NameError:
            network_available_sec = 0.0

        if not isinstance(packet, dict):
            return

        now_sec = lf.time.logical_elapsed() / 1e9
        trace_now_sec = lf.time.physical_elapsed() / 1e9
        delay_ms = _network_receiver_delay_ms(reactor, packet)
        network_start_sec = max(now_sec, network_available_sec)
        network_end_sec = network_start_sec + (float(delay_ms) / 1000.0)
        network_available_sec = network_end_sec

        packet["network_start_time_sec"] = network_start_sec
        packet["network_end_time_sec"] = network_end_sec
        packet["network_trace_start_time_sec"] = packet.get("sent_time_sec", trace_now_sec)
        packet["network_trace_end_time_sec"] = trace_now_sec

        pending = reactor.pending_packets.setdefault(source_name, [])
        pending.append(packet)
        pending.sort(key=lambda pending_packet: pending_packet["network_end_time_sec"])

        wait_ms = max(0, int((network_end_sec - now_sec) * 1000.0 + 0.999999))
        # delay_action.schedule(MSEC(wait_ms))
        delay_action.schedule(0)
        task = packet.get("task")
        task_name = task.name if task is not None else "unknown"
        print(f"{reactor.receiver_device_name}: Queued network delivery for task {task_name} "
              f"from {network_start_sec * 1000.0:.1f} ms to {network_end_sec * 1000.0:.1f} ms")

    def _pop_ready_network_receiver_packet(reactor, source_name, delay_action):
        now_sec = lf.time.logical_elapsed() / 1e9
        pending = reactor.pending_packets.setdefault(source_name, [])
        pending.sort(key=lambda packet: packet["network_end_time_sec"])

        if len(pending) == 0:
            return None

        packet = pending[0]
        if packet["network_end_time_sec"] > now_sec + 1e-9:
            wait_ms = max(1, int((packet["network_end_time_sec"] - now_sec) * 1000.0 + 0.999999))
            delay_action.schedule(MSEC(wait_ms))
            return None

        packet = pending.pop(0)
        packet["network_trace_end_time_sec"] = lf.time.physical_elapsed() / 1e9
        if len(pending) > 0:
            next_packet = pending[0]
            wait_ms = max(0, int((next_packet["network_end_time_sec"] - now_sec) * 1000.0 + 0.999999))
            delay_action.schedule(MSEC(wait_ms))

        return packet

    def _accept_chain_packet(reactor, packet):
        if not isinstance(packet, dict) or "task" not in packet or "device" not in packet:
            return
        if packet["device"] != reactor.device_index:
            return

        task = packet["task"]
        task_index = task.index
        if task_index in reactor.completed_task_indexes:
            return
        if reactor.current_packet is not None and reactor.current_packet["task"].index == task_index:
            return

        if task_index not in reactor.pending_task_packets:
            reactor.pending_task_packets[task_index] = packet

        parent_task = packet.get("parent_task")
        reactor.received_parent_indexes.setdefault(task_index, set())
        if parent_task is not None:
            reactor.received_parent_indexes[task_index].add(parent_task.index)

        required_parents = set(task.parent_task_indexes)
        received_parents = reactor.received_parent_indexes[task_index]
        if len(required_parents) > 0 and not required_parents.issubset(received_parents):
            print(f"{reactor.device_name}: Waiting for parents of task {task.name}. "
                  f"received={sorted(received_parents)}, required={sorted(required_parents)}")
            return

        if any(queued["task"].index == task_index for queued in reactor.task_queue):
            return
        reactor.task_queue.append(reactor.pending_task_packets[task_index])

    def _schedule_next_chain_task(reactor, start_execution):
        if reactor.current_packet is None and len(reactor.task_queue) > 0:
            reactor.current_packet = reactor.task_queue.pop(0)
            task = reactor.current_packet["task"]
            print(f"{reactor.device_name}: Schedule task {task.name}")
            start_execution.schedule(0)

    def _record_arrived_packet(reactor, packet):
        if not isinstance(packet, dict):
            return
        sender_device = packet.get("sender_device")
        start_time_sec = packet.get("network_trace_start_time_sec", packet.get("network_start_time_sec"))
        end_time_sec = packet.get("network_trace_end_time_sec", packet.get("network_end_time_sec"))
        task = packet.get("task")
        if sender_device is None or start_time_sec is None or end_time_sec is None or task is None:
            return
        if sender_device == reactor.device_index:
            return

        reactor.trace_events.append({
            "type": "comm_send",
            "task_name": task.name,
            "from_device": sender_device,
            "to_device": reactor.device_index,
            "start_time": start_time_sec,
            "end_time": end_time_sec,
            "output_size": packet.get("payload_size", 0)
        })
=}

reactor NetworkReceiver(receiver_device_index = 0, receiver_device_name = "Jetson") {
    state pending_packets
    state bandwidth = []
    state latency = []

    input network_info
    input recv_edge
    input recv_cloudlet

    logical action comm_delay_edge
    logical action comm_delay_cloudlet

    output forward_edge
    output forward_cloudlet

    reaction(startup) {=
        self.pending_packets = {"edge": [], "cloudlet": []}
        self.bandwidth = []
        self.latency = []
    =}

    reaction(network_info) {=
        _apply_network_info(self, network_info.value)
    =}

    reaction(recv_edge, recv_cloudlet) -> comm_delay_edge, comm_delay_cloudlet {=
        if recv_edge.is_present:
            _queue_network_receiver_packet(self, "edge", recv_edge.value, comm_delay_edge)

        if recv_cloudlet.is_present:
            _queue_network_receiver_packet(self, "cloudlet", recv_cloudlet.value, comm_delay_cloudlet)
    =}

    reaction(comm_delay_edge) -> forward_edge {=
        packet = _pop_ready_network_receiver_packet(self, "edge", comm_delay_edge)
        if packet is not None:
            forward_edge.set(packet)
    =}

    reaction(comm_delay_cloudlet) -> forward_cloudlet {=
        packet = _pop_ready_network_receiver_packet(self, "cloudlet", comm_delay_cloudlet)
        if packet is not None:
            forward_cloudlet.set(packet)
    =}
}

reactor Jetson(device_index = 0, device_name = "Jetson") {
    state task_queue = []
    state current_packet
    state pending_task_packets
    state received_parent_indexes
    state completed_task_indexes = []
    state trace_events = []
    state current_comp_start_time = 0.0
    state pending_packets = []
    state compute_thread
    state compute_error

    input network_info
    input task_chains
    input recv_edge
    input recv_cloudlet

    logical action start_execution
    logical action end_execution
    logical action send_packet
    physical action compute_done

    output send_edge
    output send_cloudlet
    output final_output
    output trace_output

    nr = new NetworkReceiver()
    network_info -> nr.network_info
    recv_edge -> nr.recv_edge
    recv_cloudlet -> nr.recv_cloudlet

    reaction(startup) {=
        self.task_queue = []
        self.current_packet = None
        self.pending_task_packets = {}
        self.received_parent_indexes = {}
        self.completed_task_indexes = set()
        self.trace_events = []
        self.pending_packets = []
        self.compute_thread = None
        self.compute_error = None
    =}

    reaction(start_execution) -> compute_done {=
        if self.current_packet is None:
            return

        elapsed_logical_time = lf.time.logical_elapsed()
        elapsed_physical_time = lf.time.physical_elapsed()
        self.current_comp_start_time = elapsed_physical_time / 1e9

        task = self.current_packet["task"]
        print(f"{self.device_name}: Execute task {task.name}")
        print(f"{self.device_name}: Tag = ({elapsed_logical_time}, {lf.tag().microstep}) "
              f"and physical time = {elapsed_physical_time}")
        exec_time_ms = task.execution_times[self.device_index]

        self.compute_error = None

        def worker():
            try:
                # Keep simulated work off the reactor thread so sends and receives can proceed.
                time.sleep(exec_time_ms / 1000.0 / time_unit)
            except BaseException as exc:
                self.compute_error = exc
                print(f"{self.device_name}: Task {task.name} failed: {exc}", flush=True)
            finally:
                compute_done.schedule(0)

        self.compute_thread = threading.Thread(target=worker, daemon=True)
        self.compute_thread.start()
    =} deadline(10 sec) {=
        print(f"In {self.device_name}'s deadline handler.")
        elapsed_logical_time = lf.time.logical_elapsed()
        elapsed_physical_time = lf.time.physical_elapsed()
        print(f"Logical time = {elapsed_logical_time} and physical time = {elapsed_physical_time}")
    =}

    reaction(compute_done) -> end_execution {=
        if self.current_packet is None:
            return
        self.compute_thread = None
        if self.compute_error is not None:
            request_stop()
            return
        end_execution.schedule(0)
    =}

    reaction(end_execution) -> start_execution, send_packet, final_output, trace_output {=
        if self.current_packet is None:
            return

        completed_packet = self.current_packet
        completed_task = completed_packet["task"]
        task_index = completed_task.index
        end_time_sec = lf.time.physical_elapsed() / 1e9
        end_ms = end_time_sec * 1000.0
        deadline_ms = int(completed_task.deadline) if completed_task.deadline is not None else -1
        deadline_met = True if deadline_ms <= 0 else (end_ms <= float(deadline_ms))

        self.trace_events.append({
            "type": "comp",
            "task_name": completed_task.name,
            "device_index": self.device_index,
            "device_name": self.device_name,
            "start_time": self.current_comp_start_time,
            "end_time": end_time_sec,
            "deadline_ms": deadline_ms,
            "deadline_met": deadline_met
        })

        self.completed_task_indexes.add(task_index)
        self.pending_task_packets.pop(task_index, None)
        self.received_parent_indexes.pop(task_index, None)
        self.current_packet = None

        for continuation in completed_packet.get("continuations", []):
            next_packet = dict(continuation)
            next_packet["parent_task"] = completed_task
            destination_device = next_packet.get("device")

            if destination_device == self.device_index:
                _accept_chain_packet(self, next_packet)
                continue

            next_packet["payload_size"] = completed_task.output_size
            self.pending_packets.append(next_packet)
            print(f"{self.device_name}: Forwarding task {next_packet['task'].name} to device {destination_device}")

        if len(self.pending_packets) > 0:
            send_packet.schedule(0)
        final_output.set(completed_task)
        trace_output.set(self.trace_events)
        _schedule_next_chain_task(self, start_execution)
    =}

    reaction(send_packet) -> send_edge, send_cloudlet, send_packet {=
        if len(self.pending_packets) == 0:
            return

        now_sec = lf.time.physical_elapsed() / 1e9
        packet = self.pending_packets.pop(0)
        destination_device = packet.get("device") if isinstance(packet, dict) else None
        if isinstance(packet, dict):
            packet["sender_device"] = self.device_index
            packet["sent_time_sec"] = now_sec
        if destination_device == 1:
            send_edge.set(packet)
        elif destination_device == 2:
            send_cloudlet.set(packet)
        else:
            print(f"{self.device_name}: Error - invalid direct destination {destination_device}")

        if len(self.pending_packets) > 0:
            send_packet.schedule(0)
    =}

    reaction(task_chains) -> start_execution, send_packet {=
        self.task_queue = []
        self.current_packet = None
        self.pending_task_packets = {}
        self.received_parent_indexes = {}
        self.completed_task_indexes = set()
        self.pending_packets = []
        self.compute_thread = None
        self.compute_error = None

        chains = task_chains.value if task_chains.is_present and isinstance(task_chains.value, list) else []
        print(f"{self.device_name}: Received {len(chains)} initial chain packet(s).")

        for packet in chains:
            if isinstance(packet, dict) and packet.get("device") == self.device_index:
                _accept_chain_packet(self, packet)
            else:
                if isinstance(packet, dict) and "task" in packet and "device" in packet:
                    task = packet["task"]
                    destination_device = packet["device"]
                    packet["payload_size"] = task.input_size
                    print(f"{self.device_name}: Forwarding input data for task {task.name} "
                          f"to device {destination_device}")
                self.pending_packets.append(packet)

        if len(self.pending_packets) > 0:
            send_packet.schedule(0)
        _schedule_next_chain_task(self, start_execution)
    =}

    reaction(nr.forward_edge, nr.forward_cloudlet) -> start_execution, send_packet {=
        packets = []
        if nr.forward_edge.is_present:
            packets.append(nr.forward_edge.value)
        if nr.forward_cloudlet.is_present:
            packets.append(nr.forward_cloudlet.value)

        for packet in packets:
            if isinstance(packet, dict) and packet.get("device") == self.device_index:
                _record_arrived_packet(self, packet)
                _accept_chain_packet(self, packet)
            else:
                self.pending_packets.append(packet)

        if len(self.pending_packets) > 0:
            send_packet.schedule(0)
        _schedule_next_chain_task(self, start_execution)
    =}
}
