target Python
preamble {=
    import gc
    import os
    import pprint
    import threading
    import time
    from collections import deque
    from dataclasses import dataclass, field
    from typing import Deque, List, Tuple

    time_unit = 1

    @dataclass
    class Task:
        name: str = ""
        index: int = 0
        deadline: int = -1
        execution_times: List[int] = field(default_factory=list)
        child_task_indexes: List[int] = field(default_factory=list, repr=False)
        parent_task_indexes: List[int] = field(default_factory=list, repr=False)
        input_size: int = 0
        output_size: int = 0
        source_device_index: int = 0
        priority: float = 0
        ready_time: int = -1
        current_device: str = ""
        communication_start_time: int = 0
        communication_end_time: int = 0
        computation_start_time: int = 0
        computation_end_time: int = 0

    @dataclass
    class Device:
        name: str = ""
        index: int = 0
        task_queue: Deque[Task] = field(default_factory=deque)
        comm_channel_available: int = 0
        comm_queue: list[Tuple[str, int, int]] = field(default_factory=list)

    cloudlet_llm_default_question = "What is the opposite of tall?"
    cloudlet_llm_default_model_id = "TinyLlama/TinyLlama-1.1B-Chat-v1.0"
    _cloudlet_llm_tokenizer = None
    _cloudlet_llm_model = None
    _cloudlet_llm_generation = None
    _cloudlet_llm_has_cuda = False
    _cloudlet_llm_torch = None
    _cloudlet_llm_lock = threading.Lock()
    blackwell_yolos_default_engine = "yolos_small_fp16.engine"
    blackwell_yolos_default_hf_model = "hustvl/yolos-small"
    blackwell_yolos_default_image_folder = "dataset128/coco128/images/train2017"
    blackwell_yolos_default_input_image = "dataset128/coco128/images/train2017/000000000127.jpg"
    _blackwell_yolos_runner = None
    _blackwell_yolos_image_paths = []
    _blackwell_yolos_image_index = 0
    _blackwell_yolos_lock = threading.Lock()

    def _accept_chain_packet(reactor, packet):
        if not isinstance(packet, dict) or "task" not in packet or "device" not in packet:
            return
        if packet["device"] != reactor.device_index:
            return

        task = packet["task"]
        task_index = task.index
        if task_index in reactor.completed_task_indexes:
            return
        if reactor.current_packet is not None and reactor.current_packet["task"].index == task_index:
            return

        if task_index not in reactor.pending_task_packets:
            reactor.pending_task_packets[task_index] = packet

        parent_task = packet.get("parent_task")
        reactor.received_parent_indexes.setdefault(task_index, set())
        if parent_task is not None:
            reactor.received_parent_indexes[task_index].add(parent_task.index)

        required_parents = set(task.parent_task_indexes)
        received_parents = reactor.received_parent_indexes[task_index]
        if len(required_parents) > 0 and not required_parents.issubset(received_parents):
            print(f"{reactor.device_name}: Waiting for parents of task {task.name}. "
                  f"received={sorted(received_parents)}, required={sorted(required_parents)}")
            return

        if any(queued["task"].index == task_index for queued in reactor.task_queue):
            return
        reactor.task_queue.append(reactor.pending_task_packets[task_index])

    def _schedule_next_chain_task(reactor, start_execution):
        if reactor.current_packet is None and len(reactor.task_queue) > 0:
            reactor.current_packet = reactor.task_queue.pop(0)
            task = reactor.current_packet["task"]
            print(f"{reactor.device_name}: Schedule task {task.name}")
            start_execution.schedule(MSEC(1))

    def _record_arrived_packet(reactor, packet):
        if not isinstance(packet, dict):
            return
        sender_device = packet.get("sender_device")
        start_time_sec = packet.get("sent_time_sec")
        end_time_sec = lf.time.physical_elapsed() / 1e9
        task = packet.get("task")
        if sender_device is None or start_time_sec is None or task is None:
            return
        if sender_device == reactor.device_index:
            return

        reactor.trace_events.append({
            "type": "comm_send",
            "task_name": task.name,
            "from_device": sender_device,
            "to_device": reactor.device_index,
            "start_time": start_time_sec,
            "end_time": end_time_sec,
            "duration_ms": max(0.0, (end_time_sec - start_time_sec) * 1000.0),
            "completion_time": end_time_sec,
            "output_size": packet.get("payload_size", 0)
        })

    def _is_llm_task(task):
        task_name = getattr(task, "name", "")
        return isinstance(task_name, str) and task_name.upper().startswith("LLM")

    def _is_vit_task(task):
        task_name = getattr(task, "name", "")
        return isinstance(task_name, str) and task_name.upper().startswith("VIT")

    def _task_snapshot(task):
        if task is None:
            return None
        try:
            return dict(vars(task))
        except TypeError:
            return str(task)

    def _packet_snapshot(packet):
        if not isinstance(packet, dict):
            return packet

        snapshot = {}
        for key, value in packet.items():
            if key == "task":
                snapshot[key] = _task_snapshot(value)
            elif key == "parent_task":
                snapshot[key] = _task_snapshot(value)
            elif key == "continuations" and isinstance(value, list):
                continuation_snapshot = []
                for continuation in value:
                    if isinstance(continuation, dict):
                        continuation_snapshot.append({
                            continuation_key: _task_snapshot(continuation_value) if continuation_key == "task" else continuation_value
                            for continuation_key, continuation_value in continuation.items()
                        })
                    else:
                        continuation_snapshot.append(continuation)
                snapshot[key] = continuation_snapshot
            else:
                snapshot[key] = value
        return snapshot

    def _attach_parent_yolos_output(packet, completed_task):
        if not isinstance(packet, dict) or completed_task is None:
            return

        yolos_fields = {
            "parent_yolos_input": getattr(completed_task, "yolos_input", None),
            "parent_yolos_inference_ms": getattr(completed_task, "yolos_inference_ms", None),
            "parent_yolos_speed": getattr(completed_task, "yolos_speed", None),
            "parent_yolos_detection_count": getattr(completed_task, "yolos_detection_count", None),
            "parent_yolos_detections": getattr(completed_task, "yolos_detections", None),
        }
        if not any(value is not None for value in yolos_fields.values()):
            return

        for key, value in yolos_fields.items():
            packet[key] = value

    def _log_received_parent_yolos_output(reactor, packet):
        if not isinstance(packet, dict):
            return

        payload = {
            "input": packet.get("parent_yolos_input"),
            "inference_ms": packet.get("parent_yolos_inference_ms"),
            "speed": packet.get("parent_yolos_speed"),
            "detection_count": packet.get("parent_yolos_detection_count"),
            "detections": packet.get("parent_yolos_detections"),
        }
        if not any(value is not None for value in payload.values()):
            return

        parent_task = packet.get("parent_task")
        next_task = packet.get("task")
        parent_name = getattr(parent_task, "name", "<unknown>")
        next_name = getattr(next_task, "name", "<unknown>")
        print(
            f"{reactor.device_name}: Received YOLOS payload from {parent_name} for {next_name}:\n"
            f"{pprint.pformat(payload, sort_dicts=False)}",
            flush=True,
        )

    def _dummy_llm_config(task):
        return {
            "model_id": os.environ.get("CLOUDLET_LLM_MODEL_ID", cloudlet_llm_default_model_id),
            "max_new_tokens": int(os.environ.get("CLOUDLET_LLM_MAX_NEW_TOKENS", "24")),
            "use_kv_cache": os.environ.get("CLOUDLET_LLM_USE_KV_CACHE", "0").lower() in ["1", "true", "yes"],
            "disable_4bit": os.environ.get("CLOUDLET_LLM_DISABLE_4BIT", "1").lower() in ["1", "true", "yes"],
            "question": getattr(task, "llm_question", None) or cloudlet_llm_default_question,
        }

    def _dummy_vit_config():
        imgsz = _blackwell_yolos_imgsz()
        input_source, input_label = _blackwell_next_yolos_input(imgsz)
        return {
            "hf_model": _blackwell_yolos_hf_model(),
            "engine": _blackwell_yolos_engine(),
            "device": _blackwell_yolos_device(),
            "confidence": _blackwell_yolos_conf(),
            "imgsz": imgsz,
            "backend": _blackwell_yolos_backend(),
            "image_folder": os.environ.get("BLACKWELL_YOLOS_IMAGE_FOLDER", blackwell_yolos_default_image_folder),
            "input_source": str(input_source),
            "input_label": input_label,
        }

    def _execute_dummy_ml_task(reactor, task, task_kind):
        exec_time_ms = task.execution_times[reactor.device_index]
        packet_snapshot = _packet_snapshot(reactor.current_packet)
        task_snapshot = _task_snapshot(task)
        if task_kind == "llm":
            config = _dummy_llm_config(task)
            task.llm_question = config["question"]
            task.llm_answer = f"dummy-answer-for-{task.name}"
            task.llm_inference_ms = 0
            reactor.llm_results[task.index] = {
                "question": task.llm_question,
                "answer": task.llm_answer,
                "inference_ms": 0,
                "dummy_task": True,
            }
            if reactor.current_packet is not None:
                reactor.current_packet["llm_question"] = task.llm_question
                reactor.current_packet["llm_answer"] = task.llm_answer
                reactor.current_packet["llm_inference_ms"] = 0
        elif task_kind == "vit":
            config = _dummy_vit_config()
            task.yolos_input = config["input_label"]
            task.yolos_inference_ms = 0
            task.yolos_speed = {"dummy": 0}
            task.yolos_detection_count = 0
            task.yolos_detections = []
            reactor.yolo_results[task.index] = {
                "input": task.yolos_input,
                "inference_ms": 0,
                "speed": task.yolos_speed,
                "detections": task.yolos_detection_count,
                "details": task.yolos_detections,
                "dummy_task": True,
            }
            if reactor.current_packet is not None:
                reactor.current_packet["yolos_input"] = task.yolos_input
                reactor.current_packet["yolos_inference_ms"] = 0
                reactor.current_packet["yolos_speed"] = task.yolos_speed
                reactor.current_packet["yolos_detection_count"] = task.yolos_detection_count
                reactor.current_packet["yolos_detections"] = task.yolos_detections
        else:
            config = {}

        config["execution_time_ms"] = exec_time_ms
        print(f"{reactor.device_name}: Dummy ML task for {task.name} ({task_kind})", flush=True)
        print(f"{reactor.device_name}: Dummy task configuration:\n{pprint.pformat(config, sort_dicts=False)}", flush=True)
        print(f"{reactor.device_name}: Dummy task input packet:\n{pprint.pformat(packet_snapshot, sort_dicts=False)}", flush=True)
        print(f"{reactor.device_name}: Dummy task input task object:\n{pprint.pformat(task_snapshot, sort_dicts=False)}", flush=True)
        return exec_time_ms

    def _blackwell_project_root():
        try:
            return os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".."))
        except NameError:
            return os.getcwd()

    def _blackwell_tensor_rt_reference_dir():
        return os.path.join(
            _blackwell_project_root(),
            "profiling-reference",
            "profiling-scheduler-cps-intelligent-system",
            "codes_2026",
            "tensor_rt",
        )

    def _blackwell_resolve_path(path_value):
        path_text = str(path_value).strip()
        expanded = os.path.expanduser(path_text)
        if os.path.isabs(expanded):
            return expanded

        for root in [os.getcwd(), _blackwell_project_root(), _blackwell_tensor_rt_reference_dir()]:
            candidate = os.path.abspath(os.path.join(root, expanded))
            if os.path.exists(candidate):
                return candidate
        return os.path.abspath(os.path.join(_blackwell_project_root(), expanded))

    def _blackwell_model_source(path_value):
        resolved = _blackwell_resolve_path(path_value)
        return resolved if os.path.exists(resolved) else str(path_value)

    def _blackwell_yolos_hf_model():
        return os.environ.get("BLACKWELL_YOLOS_HF_MODEL", blackwell_yolos_default_hf_model)

    def _blackwell_yolos_engine():
        default_engine = blackwell_yolos_default_engine
        hf_model = _blackwell_yolos_hf_model()
        precision = os.environ.get("BLACKWELL_YOLOS_PRECISION", "fp16").lower()
        if hf_model == "hustvl/yolos-base":
            default_engine = f"yolos_base_{precision}.engine"
        elif hf_model == "hustvl/yolos-small":
            default_engine = f"yolos_small_{precision}.engine"
        return os.environ.get("BLACKWELL_YOLOS_ENGINE", default_engine)

    def _blackwell_yolos_device():
        device = os.environ.get("BLACKWELL_YOLOS_DEVICE", "cuda:0")
        if device.isdigit():
            return f"cuda:{device}"
        return device

    def _blackwell_yolos_conf():
        return float(os.environ.get("BLACKWELL_YOLOS_CONF", "0.3"))

    def _blackwell_yolos_imgsz():
        return int(os.environ.get("BLACKWELL_YOLOS_IMGSZ", "640"))

    def _blackwell_yolos_backend():
        return os.environ.get("BLACKWELL_YOLOS_BACKEND", "auto").lower()

    def _blackwell_find_yolos_images():
        image_folder = os.environ.get("BLACKWELL_YOLOS_IMAGE_FOLDER", blackwell_yolos_default_image_folder)
        folder = _blackwell_resolve_path(image_folder)
        if not os.path.isdir(folder):
            return []

        paths = []
        for root, _, files in os.walk(folder):
            for name in files:
                if name.lower().endswith((".jpg", ".jpeg", ".png", ".bmp")):
                    paths.append(os.path.join(root, name))
        paths.sort()
        return paths

    def _blackwell_yolos_detection_limit():
        return int(os.environ.get("BLACKWELL_YOLOS_PRINT_TOPK", "5"))

    def _blackwell_format_yolos_detections(detection, id2label):
        details = []
        if not detection:
            return details

        scores = detection["scores"].detach().cpu().tolist()
        labels = detection["labels"].detach().cpu().tolist()
        boxes = detection["boxes"].detach().cpu().tolist()
        for score, label_id, box in zip(scores, labels, boxes):
            details.append({
                "label": id2label.get(int(label_id), str(int(label_id))),
                "score": round(float(score), 4),
                "box": [round(float(value), 2) for value in box],
            })
        return details[:_blackwell_yolos_detection_limit()]

    def _blackwell_next_yolos_input(imgsz):
        global _blackwell_yolos_image_index

        if len(_blackwell_yolos_image_paths) == 0:
            fallback = _blackwell_resolve_path(blackwell_yolos_default_input_image)
            if os.path.exists(fallback):
                return fallback, fallback
            return None, "synthetic-zero-image"

        path = _blackwell_yolos_image_paths[_blackwell_yolos_image_index % len(_blackwell_yolos_image_paths)]
        _blackwell_yolos_image_index += 1
        return path, path

    class _BlackwellYolosTorchRunner:
        def __init__(self, hf_model, imgsz, conf, device):
            import torch
            from PIL import Image
            from transformers import YolosForObjectDetection, YolosImageProcessor

            self.torch = torch
            self.Image = Image
            self.processor = YolosImageProcessor.from_pretrained(hf_model)
            self.model = YolosForObjectDetection.from_pretrained(hf_model).to(device).eval()
            self.id2label = self.model.config.id2label
            self.imgsz = imgsz
            self.conf = conf
            self.device = device
            self.backend = "PyTorch"
            self.source = hf_model

        def _read_image(self, path):
            if path is None:
                return self.Image.new("RGB", (self.imgsz, self.imgsz), color=(0, 0, 0))
            return self.Image.open(path).convert("RGB")

        def infer(self, path):
            image = self._read_image(path)
            w0, h0 = image.size

            start_ns = time.perf_counter_ns()
            inputs = self.processor(
                images=image,
                size={"height": self.imgsz, "width": self.imgsz},
                return_tensors="pt",
            )
            inputs = {name: value.to(self.device) for name, value in inputs.items()}
            if self.device.startswith("cuda"):
                self.torch.cuda.synchronize()
            with self.torch.inference_mode():
                outputs = self.model(**inputs)
            if self.device.startswith("cuda"):
                self.torch.cuda.synchronize()
            detections = self.processor.post_process_object_detection(
                outputs,
                threshold=self.conf,
                target_sizes=self.torch.tensor([[h0, w0]], device=self.device),
            )
            end_ns = time.perf_counter_ns()

            return {
                "inference_ms": int((end_ns - start_ns) / 1_000_000),
                "detections": len(detections[0]["scores"]) if detections else 0,
                "details": _blackwell_format_yolos_detections(detections[0] if detections else None, self.id2label),
                "speed": {},
            }

    class _BlackwellYolosTensorRTRunner:
        def __init__(self, engine_path, hf_model, imgsz, conf):
            import numpy as np
            import tensorrt as trt
            import torch
            from cuda.bindings import driver as cuda
            from PIL import Image
            from transformers import AutoConfig, YolosImageProcessor

            self.np = np
            self.trt = trt
            self.torch = torch
            self.cuda = cuda
            self.Image = Image
            self.processor = YolosImageProcessor.from_pretrained(hf_model)
            self.id2label = AutoConfig.from_pretrained(hf_model).id2label
            self.imgsz = imgsz
            self.conf = conf
            self.backend = "TensorRT"
            self.source = engine_path

            self._cuda_check(cuda.cuInit(0)[0])
            logger = trt.Logger(trt.Logger.WARNING)
            runtime = trt.Runtime(logger)
            with open(engine_path, "rb") as f:
                self.engine = runtime.deserialize_cuda_engine(f.read())
            if self.engine is None:
                raise RuntimeError(f"Failed to load YOLOS TensorRT engine: {engine_path}")

            self.context = self.engine.create_execution_context()
            if self.context is None:
                raise RuntimeError(f"Failed to create TensorRT context: {engine_path}")

            self.input_name = None
            self.output_names = []
            for i in range(self.engine.num_io_tensors):
                name = self.engine.get_tensor_name(i)
                mode = self.engine.get_tensor_mode(name)
                if mode == trt.TensorIOMode.INPUT:
                    self.input_name = name
                else:
                    self.output_names.append(name)
            if self.input_name is None:
                raise RuntimeError("YOLOS TensorRT engine has no input tensor")

            input_shape = tuple(self.engine.get_tensor_shape(self.input_name))
            if any(d == -1 for d in input_shape):
                input_shape = (1, 3, imgsz, imgsz)
                ok = self.context.set_input_shape(self.input_name, input_shape)
                if not ok:
                    raise RuntimeError(f"Failed to set TensorRT input shape: {input_shape}")

            self.input_dtype = trt.nptype(self.engine.get_tensor_dtype(self.input_name))
            self.dptrs = {}
            self.host_bufs = {}
            self.output_shapes = {}

            input_nbytes = int(np.prod(input_shape)) * np.dtype(self.input_dtype).itemsize
            self.dptrs[self.input_name] = self._malloc(input_nbytes)
            self.context.set_tensor_address(self.input_name, self.dptrs[self.input_name])

            for name in self.output_names:
                shape = tuple(self.context.get_tensor_shape(name))
                if any(d < 0 for d in shape):
                    raise RuntimeError(f"Dynamic output shape unresolved for {name}: {shape}")
                dtype = trt.nptype(self.engine.get_tensor_dtype(name))
                self.output_shapes[name] = shape
                self.host_bufs[name] = np.empty(shape, dtype=dtype)
                self.dptrs[name] = self._malloc(self.host_bufs[name].nbytes)
                self.context.set_tensor_address(name, self.dptrs[name])

            self.logits_name, self.boxes_name = self._find_yolos_outputs(self.output_shapes)
            err, self.stream = cuda.cuStreamCreate(0)
            self._cuda_check(err)

        def _cuda_check(self, err):
            if err != self.cuda.CUresult.CUDA_SUCCESS:
                raise RuntimeError(f"CUDA error: {err}")

        def _malloc(self, nbytes):
            err, ptr = self.cuda.cuMemAlloc(nbytes)
            self._cuda_check(err)
            return int(ptr)

        def _find_yolos_outputs(self, output_shapes):
            logits_name = None
            boxes_name = None
            for name, shape in output_shapes.items():
                if len(shape) != 3:
                    continue
                if shape[1] == 100 and shape[2] == 4:
                    boxes_name = name
                elif shape[1] == 100 and shape[2] > 4:
                    logits_name = name
            if logits_name is None or boxes_name is None:
                raise RuntimeError(f"Could not identify YOLOS outputs from: {output_shapes}")
            return logits_name, boxes_name

        def _read_image(self, path):
            if path is None:
                return self.Image.new("RGB", (self.imgsz, self.imgsz), color=(0, 0, 0))
            return self.Image.open(path).convert("RGB")

        def infer(self, path):
            image = self._read_image(path)
            w0, h0 = image.size

            start_ns = time.perf_counter_ns()
            inputs = self.processor(
                images=image,
                size={"height": self.imgsz, "width": self.imgsz},
                return_tensors="pt",
            )
            x = inputs["pixel_values"].cpu().numpy().astype(self.input_dtype, copy=False)
            x = self.np.ascontiguousarray(x)

            err, = self.cuda.cuMemcpyHtoD(self.dptrs[self.input_name], x.ctypes.data, x.nbytes)
            self._cuda_check(err)
            ok = self.context.execute_async_v3(stream_handle=self.stream)
            if not ok:
                raise RuntimeError("YOLOS TensorRT inference failed")
            for out_name in self.output_names:
                err, = self.cuda.cuMemcpyDtoH(
                    self.host_bufs[out_name].ctypes.data,
                    self.dptrs[out_name],
                    self.host_bufs[out_name].nbytes,
                )
                self._cuda_check(err)
            err, = self.cuda.cuStreamSynchronize(self.stream)
            self._cuda_check(err)

            logits_t = self.torch.from_numpy(self.host_bufs[self.logits_name].copy())
            boxes_t = self.torch.from_numpy(self.host_bufs[self.boxes_name].copy())
            outputs = type("YolosOutput", (), {"logits": logits_t, "pred_boxes": boxes_t})()
            detections = self.processor.post_process_object_detection(
                outputs,
                threshold=self.conf,
                target_sizes=self.torch.tensor([[h0, w0]]),
            )
            end_ns = time.perf_counter_ns()

            return {
                "inference_ms": int((end_ns - start_ns) / 1_000_000),
                "detections": len(detections[0]["scores"]) if detections else 0,
                "details": _blackwell_format_yolos_detections(detections[0] if detections else None, self.id2label),
                "speed": {},
            }

    def _load_blackwell_yolos():
        global _blackwell_yolos_runner
        global _blackwell_yolos_image_paths

        if _blackwell_yolos_runner is not None:
            return _blackwell_yolos_runner

        hf_model = _blackwell_yolos_hf_model()
        imgsz = _blackwell_yolos_imgsz()
        conf = _blackwell_yolos_conf()
        backend = _blackwell_yolos_backend()
        engine_path = _blackwell_resolve_path(_blackwell_yolos_engine())
        use_trt = backend in ["auto", "trt", "tensorrt"] and os.path.exists(engine_path)

        _blackwell_yolos_image_paths = _blackwell_find_yolos_images()
        sample_input, _ = _blackwell_next_yolos_input(imgsz)

        if use_trt:
            runner = _BlackwellYolosTensorRTRunner(engine_path, hf_model, imgsz, conf)
        elif backend in ["trt", "tensorrt"]:
            raise RuntimeError(f"BLACKWELL_YOLOS_BACKEND={backend}, but engine was not found: {engine_path}")
        else:
            device = _blackwell_yolos_device()
            runner = _BlackwellYolosTorchRunner(hf_model, imgsz, conf, device)

        warmup = int(os.environ.get("BLACKWELL_YOLOS_WARMUP", "1"))
        for _ in range(max(0, warmup)):
            runner.infer(sample_input)

        print(
            f"Blackwell: YOLOS model ready from {runner.source}; backend={runner.backend}, "
            f"hf_model={hf_model}, images={len(_blackwell_yolos_image_paths)}",
            flush=True,
        )
        _blackwell_yolos_runner = runner
        return _blackwell_yolos_runner

    def _resolve_yolos_task_input(reactor, task, imgsz):
        input_image = getattr(task, "input_image", None)
        if not input_image and reactor.current_packet is not None:
            input_image = reactor.current_packet.get("input_image")
        if not input_image and reactor.current_packet is not None:
            input_image = reactor.current_packet.get("image_path")
        if input_image:
            input_source = _blackwell_resolve_path(input_image)
            return input_source, input_source
        return _blackwell_next_yolos_input(imgsz)

    def _execute_blackwell_yolos_task(reactor, task):
        with _blackwell_yolos_lock:
            runner = _load_blackwell_yolos()
            imgsz = _blackwell_yolos_imgsz()
            input_source, input_label = _resolve_yolos_task_input(reactor, task, imgsz)
            result = runner.infer(input_source)

        inference_ms = result["inference_ms"]
        detection_count = result["detections"]
        detection_details = result.get("details", [])
        speed = result["speed"]

        task.yolos_input = input_label
        task.yolos_inference_ms = inference_ms
        task.yolos_speed = speed
        task.yolos_detection_count = detection_count
        task.yolos_detections = detection_details
        reactor.yolo_results[task.index] = {
            "input": input_label,
            "inference_ms": inference_ms,
            "speed": speed,
            "detections": detection_count,
            "details": detection_details,
        }
        if reactor.current_packet is not None:
            reactor.current_packet["yolos_input"] = input_label
            reactor.current_packet["yolos_inference_ms"] = inference_ms
            reactor.current_packet["yolos_speed"] = speed
            reactor.current_packet["yolos_detection_count"] = detection_count
            reactor.current_packet["yolos_detections"] = detection_details

        print(
            f"{reactor.device_name}: YOLOS inference for {task.name}: "
            f"{inference_ms} ms, detections={detection_count}, input={input_label}",
            flush=True,
        )
        print(f"{reactor.device_name}: YOLOS output top detections: {detection_details}", flush=True)

    def _load_cloudlet_llm():
        global _cloudlet_llm_tokenizer
        global _cloudlet_llm_model
        global _cloudlet_llm_generation
        global _cloudlet_llm_has_cuda
        global _cloudlet_llm_torch

        if _cloudlet_llm_model is not None:
            return

        import torch
        from transformers import AutoTokenizer, AutoModelForCausalLM, BitsAndBytesConfig

        model_id = os.environ.get("CLOUDLET_LLM_MODEL_ID", cloudlet_llm_default_model_id)
        has_cuda = torch.cuda.is_available()
        dtype = torch.float16 if has_cuda else torch.float32

        print(f"Blackwell: Loading LLM model {model_id}", flush=True)
        if not has_cuda:
            print("Blackwell: CUDA is not available; loading LLM on CPU.", flush=True)

        tokenizer = AutoTokenizer.from_pretrained(model_id, use_fast=True)
        if tokenizer.pad_token_id is None:
            tokenizer.pad_token = tokenizer.eos_token

        common = dict(
            device_map="auto" if has_cuda else None,
            dtype=dtype,
            low_cpu_mem_usage=True,
        )

        use_4bit = has_cuda and os.environ.get("CLOUDLET_LLM_DISABLE_4BIT", "1").lower() not in ["1", "true", "yes"]
        if use_4bit:
            try:
                import bitsandbytes as bnb
                common["quantization_config"] = BitsAndBytesConfig(
                    load_in_4bit=True,
                    bnb_4bit_quant_type="nf4",
                    bnb_4bit_use_double_quant=True,
                    bnb_4bit_compute_dtype=dtype,
                )
            except Exception as exc:
                print(f"Blackwell: bitsandbytes unavailable; loading LLM without 4-bit quantization: {exc}", flush=True)

        model = AutoModelForCausalLM.from_pretrained(model_id, **common)
        model.eval()

        max_new_tokens = int(os.environ.get("CLOUDLET_LLM_MAX_NEW_TOKENS", "24"))
        use_kv_cache = os.environ.get("CLOUDLET_LLM_USE_KV_CACHE", "0").lower() in ["1", "true", "yes"]
        _cloudlet_llm_tokenizer = tokenizer
        _cloudlet_llm_model = model
        _cloudlet_llm_generation = dict(
            max_new_tokens=max_new_tokens,
            do_sample=False,
            use_cache=use_kv_cache,
            eos_token_id=tokenizer.eos_token_id,
            pad_token_id=tokenizer.pad_token_id,
        )
        _cloudlet_llm_has_cuda = has_cuda
        _cloudlet_llm_torch = torch
        print("Blackwell: LLM model ready.", flush=True)

    def _run_cloudlet_llm(question):
        with _cloudlet_llm_lock:
            _load_cloudlet_llm()

            prompt = f"You are a concise Q&A assistant.\n\nQuestion: {question}\nAnswer:"
            inputs = _cloudlet_llm_tokenizer(prompt, return_tensors="pt")
            if _cloudlet_llm_has_cuda:
                inputs = {k: v.to("cuda") for k, v in inputs.items()}
                _cloudlet_llm_torch.cuda.synchronize()

            with _cloudlet_llm_torch.inference_mode():
                output = _cloudlet_llm_model.generate(**inputs, **_cloudlet_llm_generation)

            if _cloudlet_llm_has_cuda:
                _cloudlet_llm_torch.cuda.synchronize()

            prompt_len = inputs["input_ids"].shape[1]
            result = _cloudlet_llm_tokenizer.decode(output[0][prompt_len:], skip_special_tokens=True)

            del output
            del inputs
            gc.collect()
            if _cloudlet_llm_has_cuda:
                _cloudlet_llm_torch.cuda.empty_cache()

        text = result.strip()
        for sep in ["\n", ". ", "  "]:
            idx = text.find(sep)
            if idx > 0:
                text = text[:idx]
                break
        return text.strip().strip(":").strip()

    def _execute_cloudlet_llm_task(reactor, task):
        question = getattr(task, "llm_question", None) or cloudlet_llm_default_question
        start_ns = time.perf_counter_ns()
        answer = _run_cloudlet_llm(question)
        end_ns = time.perf_counter_ns()
        inference_ms = int((end_ns - start_ns) / 1_000_000)

        task.llm_question = question
        task.llm_answer = answer
        task.llm_inference_ms = inference_ms
        reactor.llm_results[task.index] = {
            "question": question,
            "answer": answer,
            "inference_ms": inference_ms,
        }
        if reactor.current_packet is not None:
            reactor.current_packet["llm_question"] = question
            reactor.current_packet["llm_answer"] = answer
            reactor.current_packet["llm_inference_ms"] = inference_ms

        print(f"{reactor.device_name}: LLM question for {task.name}: {question}", flush=True)
        print(f"{reactor.device_name}: LLM answer for {task.name}: {answer} ({inference_ms} ms)", flush=True)

=}

reactor Blackwell(device_index = 2, device_name = "Blackwell", dummy_task = False) {
    state task_queue = []
    state current_packet
    state pending_task_packets
    state received_parent_indexes
    state completed_task_indexes = []
    state trace_events = []
    state current_comp_start_time = 0.0
    state pending_packets = []
    state llm_results
    state yolo_results
    state llm_thread
    state llm_error

    input task_chains
    input recv_mobile_robot
    input recv_edge

    logical action start_execution
    logical action end_execution
    logical action send_packet
    physical action llm_done

    output send_mobile_robot
    output send_edge
    output final_output
    output trace_output

    reaction(startup) {=
        self.task_queue = []
        self.current_packet = None
        self.pending_task_packets = {}
        self.received_parent_indexes = {}
        self.completed_task_indexes = set()
        self.trace_events = []
        self.pending_packets = []
        self.llm_results = {}
        self.yolo_results = {}
        self.llm_thread = None
        self.llm_error = None
    =}

    reaction(start_execution) -> end_execution, llm_done {=
        if self.current_packet is None:
            return

        elapsed_logical_time = lf.time.logical_elapsed()
        elapsed_physical_time = lf.time.physical_elapsed()
        self.current_comp_start_time = lf.time.physical_elapsed() / 1e9

        task = self.current_packet["task"]
        print(f"{self.device_name}: Execute task {task.name}")
        print(f"{self.device_name}: Tag = ({elapsed_logical_time}, {lf.tag().microstep}) "
              f"and physical time = {elapsed_physical_time}")
        exec_time_ms = task.execution_times[self.device_index]
        if _is_llm_task(task):
            if self.dummy_task:
                self.llm_error = None

                def worker():
                    try:
                        dummy_exec_time_ms = _execute_dummy_ml_task(self, task, "llm")
                        time.sleep(dummy_exec_time_ms / 1000.0 / time_unit)
                    except BaseException as exc:
                        self.llm_error = exc
                        print(f"{self.device_name}: Dummy LLM task {task.name} failed: {exc}", flush=True)
                    finally:
                        llm_done.schedule(0)

                self.llm_thread = threading.Thread(target=worker, daemon=True)
                self.llm_thread.start()
                return

            self.llm_error = None

            def worker():
                try:
                    _execute_cloudlet_llm_task(self, task)
                except BaseException as exc:
                    self.llm_error = exc
                    print(f"{self.device_name}: LLM task {task.name} failed: {exc}", flush=True)
                finally:
                    llm_done.schedule(0)

            self.llm_thread = threading.Thread(target=worker, daemon=True)
            self.llm_thread.start()
        elif _is_vit_task(task):
            if self.dummy_task:
                def worker():
                    try:
                        dummy_exec_time_ms = _execute_dummy_ml_task(self, task, "vit")
                        time.sleep(dummy_exec_time_ms / 1000.0 / time_unit)
                    except BaseException as exc:
                        print(f"{self.device_name}: Dummy YOLO task {task.name} failed: {exc}", flush=True)
                        request_stop()
                        return
                    end_execution.schedule(0)

                threading.Thread(target=worker, daemon=True).start()
                return
            try:
                _execute_blackwell_yolos_task(self, task)
            except BaseException as exc:
                print(f"{self.device_name}: YOLOS task {task.name} failed: {exc}", flush=True)
                request_stop()
                return
            end_execution.schedule(0)
        else:
            time.sleep(exec_time_ms / 1000.0 / time_unit)
            end_execution.schedule(MSEC(int(exec_time_ms)))
    =} deadline(10000 sec) {=
        print(f"In {self.device_name}'s deadline handler.")
        elapsed_logical_time = lf.time.logical_elapsed()
        elapsed_physical_time = lf.time.physical_elapsed()
        print(f"Logical time = {elapsed_logical_time} and physical time = {elapsed_physical_time}")
    =}

    reaction(llm_done) -> end_execution {=
        if self.current_packet is None:
            return
        self.llm_thread = None
        if self.llm_error is not None:
            request_stop()
            return
        end_execution.schedule(0)
    =}

    reaction(end_execution) -> start_execution, send_packet, final_output, trace_output {=
        if self.current_packet is None:
            return

        completed_packet = self.current_packet
        completed_task = completed_packet["task"]
        task_index = completed_task.index
        end_time_sec = lf.time.physical_elapsed() / 1e9
        end_ms = end_time_sec * 1000.0
        deadline_ms = int(completed_task.deadline) if completed_task.deadline is not None else -1
        deadline_met = True if deadline_ms <= 0 else (end_ms <= float(deadline_ms))

        self.trace_events.append({
            "type": "comp",
            "task_index": task_index,
            "task_name": completed_task.name,
            "device_index": self.device_index,
            "device_name": self.device_name,
            "start_time": self.current_comp_start_time,
            "end_time": end_time_sec,
            "duration_ms": max(0.0, (end_time_sec - self.current_comp_start_time) * 1000.0),
            "completion_time": end_time_sec,
            "deadline_ms": deadline_ms,
            "deadline_met": deadline_met
        })

        self.completed_task_indexes.add(task_index)
        self.pending_task_packets.pop(task_index, None)
        self.received_parent_indexes.pop(task_index, None)
        self.current_packet = None

        for continuation in completed_packet.get("continuations", []):
            next_packet = dict(continuation)
            next_packet["parent_task"] = completed_task
            _attach_parent_yolos_output(next_packet, completed_task)
            if _is_llm_task(completed_task):
                next_packet["parent_llm_answer"] = getattr(completed_task, "llm_answer", None)
            destination_device = next_packet.get("device")

            if destination_device == self.device_index:
                _accept_chain_packet(self, next_packet)
                continue

            next_packet["payload_size"] = completed_task.output_size
            self.pending_packets.append(next_packet)
            print(f"{self.device_name}: Forwarding task {next_packet['task'].name} to device {destination_device}")

        if len(self.pending_packets) > 0:
            send_packet.schedule(0)
        final_output.set(completed_task)
        trace_output.set(self.trace_events)
        _schedule_next_chain_task(self, start_execution)
    =}

    reaction(send_packet) -> send_mobile_robot, send_edge, send_packet {=
        if len(self.pending_packets) == 0:
            return

        packet = self.pending_packets.pop(0)
        destination_device = packet.get("device") if isinstance(packet, dict) else None
        if isinstance(packet, dict):
            packet["sender_device"] = self.device_index
            packet["sent_time_sec"] = lf.time.physical_elapsed() / 1e9
        if destination_device == 0:
            send_mobile_robot.set(packet)
        elif destination_device == 1:
            send_edge.set(packet)
        else:
            print(f"{self.device_name}: Error - invalid direct destination {destination_device}")

        if len(self.pending_packets) > 0:
            send_packet.schedule(0)
    =}

    reaction(task_chains) -> start_execution, send_packet, trace_output {=
        self.task_queue = []
        self.current_packet = None
        self.pending_task_packets = {}
        self.received_parent_indexes = {}
        self.completed_task_indexes = set()
        self.trace_events = []
        self.pending_packets = []
        self.llm_results = {}
        self.yolo_results = {}
        self.llm_thread = None
        self.llm_error = None

        chains = task_chains.value if task_chains.is_present and isinstance(task_chains.value, list) else []
        print(f"{self.device_name}: Received {len(chains)} initial chain packet(s).")

        for packet in chains:
            if isinstance(packet, dict) and packet.get("device") == self.device_index:
                _accept_chain_packet(self, packet)
            else:
                if isinstance(packet, dict) and "task" in packet and "device" in packet:
                    task = packet["task"]
                    destination_device = packet["device"]
                    packet["payload_size"] = task.input_size
                    print(f"{self.device_name}: Forwarding input data for task {task.name} "
                          f"to device {destination_device}")
                self.pending_packets.append(packet)

        if len(self.pending_packets) > 0:
            send_packet.schedule(0)
        _schedule_next_chain_task(self, start_execution)
        trace_output.set(self.trace_events)
    =}

    reaction(recv_mobile_robot, recv_edge) -> start_execution, send_packet {=
        packets = []
        if recv_mobile_robot.is_present:
            packets.append(recv_mobile_robot.value)
        if recv_edge.is_present:
            packets.append(recv_edge.value)

        for packet in packets:
            if isinstance(packet, dict) and packet.get("device") == self.device_index:
                _record_arrived_packet(self, packet)
                _log_received_parent_yolos_output(self, packet)
                _accept_chain_packet(self, packet)
            else:
                self.pending_packets.append(packet)

        if len(self.pending_packets) > 0:
            send_packet.schedule(0)
        _schedule_next_chain_task(self, start_execution)
    =}
}
