target Python
preamble {=
    import gc
    import math
    import os
    import threading
    import time
    from collections import deque
    from dataclasses import dataclass, field
    from typing import Deque, List, Tuple

    time_unit = 1

    def transfer_time_ms(data_size_mb: float, bandwidth_mb_per_sec: int) -> int:
        if data_size_mb == 0 or bandwidth_mb_per_sec == 0:
            return 0
        return int(math.ceil(float(data_size_mb) / float(bandwidth_mb_per_sec)))

    network_available_sec = 0.0

    def reset_network_serialization():
        global network_available_sec
        network_available_sec = 0.0

    @dataclass
    class Task:
        name: str = ""
        index: int = 0
        deadline: int = -1
        execution_times: List[int] = field(default_factory=list)
        child_task_indexes: List[int] = field(default_factory=list, repr=False)
        parent_task_indexes: List[int] = field(default_factory=list, repr=False)
        input_size: int = 0
        output_size: int = 0
        source_device_index: int = 0
        priority: float = 0
        ready_time: int = -1
        current_device: str = ""
        communication_start_time: int = 0
        communication_end_time: int = 0
        computation_start_time: int = 0
        computation_end_time: int = 0

    @dataclass
    class Device:
        name: str = ""
        index: int = 0
        task_queue: Deque[Task] = field(default_factory=deque)
        comm_channel_available: int = 0
        comm_queue: list[Tuple[str, int, int]] = field(default_factory=list)

    cloudlet_llm_default_question = "What is the capital of South Korea?"
    cloudlet_llm_default_model_id = "meta-llama/Llama-2-7b-chat-hf"
    _cloudlet_llm_tokenizer = None
    _cloudlet_llm_model = None
    _cloudlet_llm_generation = None
    _cloudlet_llm_has_cuda = False
    _cloudlet_llm_torch = None
    _cloudlet_llm_lock = threading.Lock()
    blackwell_yolo12_default_weights = "yolo12l.pt"
    blackwell_yolo12_default_engine = "yolo12l.engine"
    blackwell_yolo12_default_image_folder = "dataset128/coco128/images/train2017"
    _blackwell_yolo12_model = None
    _blackwell_yolo12_image_paths = []
    _blackwell_yolo12_image_index = 0
    _blackwell_yolo12_lock = threading.Lock()

    def _apply_network_info(reactor, info):
        if not isinstance(info, dict):
            return
        reactor.bandwidth = info.get("bandwidth", [])
        reactor.latency = info.get("latency", [])

    def _network_receiver_delay_ms(reactor, packet):
        if not isinstance(packet, dict):
            return 0

        sender_device = packet.get("sender_device")
        receiver_device = reactor.receiver_device_index
        payload_size = packet.get("payload_size", 0)

        latency_ms = 0
        bandwidth = 0
        try:
            if sender_device is not None:
                latency_ms = reactor.latency[sender_device][receiver_device]
                bandwidth = reactor.bandwidth[sender_device][receiver_device]
        except (IndexError, TypeError):
            latency_ms = 0
            bandwidth = 0

        transfer_ms = transfer_time_ms(payload_size, bandwidth) if bandwidth > 0 else 0
        return int(latency_ms) + int(transfer_ms)

    def _queue_network_receiver_packet(reactor, source_name, packet, delay_action):
        global network_available_sec
        try:
            network_available_sec
        except NameError:
            network_available_sec = 0.0

        if not isinstance(packet, dict):
            return

        now_sec = lf.time.logical_elapsed() / 1e9
        trace_now_sec = lf.time.physical_elapsed() / 1e9
        delay_ms = _network_receiver_delay_ms(reactor, packet)
        network_start_sec = max(now_sec, network_available_sec)
        network_end_sec = network_start_sec + (float(delay_ms) / 1000.0)
        network_available_sec = network_end_sec

        packet["network_start_time_sec"] = network_start_sec
        packet["network_end_time_sec"] = network_end_sec
        packet["network_trace_start_time_sec"] = packet.get("sent_time_sec", trace_now_sec)
        packet["network_trace_end_time_sec"] = trace_now_sec

        pending = reactor.pending_packets.setdefault(source_name, [])
        pending.append(packet)
        pending.sort(key=lambda pending_packet: pending_packet["network_end_time_sec"])

        wait_ms = max(0, int((network_end_sec - now_sec) * 1000.0 + 0.999999))
        # delay_action.schedule(MSEC(wait_ms))
        delay_action.schedule(0)
        task = packet.get("task")
        task_name = task.name if task is not None else "unknown"
        print(f"{reactor.receiver_device_name}: Queued network delivery for task {task_name} "
              f"from {network_start_sec * 1000.0:.1f} ms to {network_end_sec * 1000.0:.1f} ms")

    def _pop_ready_network_receiver_packet(reactor, source_name, delay_action):
        now_sec = lf.time.logical_elapsed() / 1e9
        pending = reactor.pending_packets.setdefault(source_name, [])
        pending.sort(key=lambda packet: packet["network_end_time_sec"])

        if len(pending) == 0:
            return None

        packet = pending[0]
        if packet["network_end_time_sec"] > now_sec + 1e-9:
            wait_ms = max(1, int((packet["network_end_time_sec"] - now_sec) * 1000.0 + 0.999999))
            delay_action.schedule(MSEC(wait_ms))
            return None

        packet = pending.pop(0)
        packet["network_trace_end_time_sec"] = lf.time.physical_elapsed() / 1e9
        if len(pending) > 0:
            next_packet = pending[0]
            wait_ms = max(0, int((next_packet["network_end_time_sec"] - now_sec) * 1000.0 + 0.999999))
            delay_action.schedule(MSEC(wait_ms))

        return packet

    def _accept_chain_packet(reactor, packet):
        if not isinstance(packet, dict) or "task" not in packet or "device" not in packet:
            return
        if packet["device"] != reactor.device_index:
            return

        task = packet["task"]
        task_index = task.index
        if task_index in reactor.completed_task_indexes:
            return
        if reactor.current_packet is not None and reactor.current_packet["task"].index == task_index:
            return

        if task_index not in reactor.pending_task_packets:
            reactor.pending_task_packets[task_index] = packet

        parent_task = packet.get("parent_task")
        reactor.received_parent_indexes.setdefault(task_index, set())
        if parent_task is not None:
            reactor.received_parent_indexes[task_index].add(parent_task.index)

        required_parents = set(task.parent_task_indexes)
        received_parents = reactor.received_parent_indexes[task_index]
        if len(required_parents) > 0 and not required_parents.issubset(received_parents):
            print(f"{reactor.device_name}: Waiting for parents of task {task.name}. "
                  f"received={sorted(received_parents)}, required={sorted(required_parents)}")
            return

        if any(queued["task"].index == task_index for queued in reactor.task_queue):
            return
        reactor.task_queue.append(reactor.pending_task_packets[task_index])

    def _schedule_next_chain_task(reactor, start_execution):
        if reactor.current_packet is None and len(reactor.task_queue) > 0:
            reactor.current_packet = reactor.task_queue.pop(0)
            task = reactor.current_packet["task"]
            print(f"{reactor.device_name}: Schedule task {task.name}")
            start_execution.schedule(0)

    def _record_arrived_packet(reactor, packet):
        if not isinstance(packet, dict):
            return
        sender_device = packet.get("sender_device")
        start_time_sec = packet.get("network_trace_start_time_sec", packet.get("network_start_time_sec"))
        end_time_sec = packet.get("network_trace_end_time_sec", packet.get("network_end_time_sec"))
        task = packet.get("task")
        if sender_device is None or start_time_sec is None or end_time_sec is None or task is None:
            return
        if sender_device == reactor.device_index:
            return

        reactor.trace_events.append({
            "type": "comm_send",
            "task_name": task.name,
            "from_device": sender_device,
            "to_device": reactor.device_index,
            "start_time": start_time_sec,
            "end_time": end_time_sec,
            "output_size": packet.get("payload_size", 0)
        })

    def _is_llm_task(task):
        task_name = getattr(task, "name", "")
        return isinstance(task_name, str) and task_name.upper().startswith("LLM")

    def _is_vit_task(task):
        task_name = getattr(task, "name", "")
        return isinstance(task_name, str) and task_name.upper().startswith("VIT")

    def _blackwell_project_root():
        try:
            return os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".."))
        except NameError:
            return os.getcwd()

    def _blackwell_tensor_rt_reference_dir():
        return os.path.join(
            _blackwell_project_root(),
            "profiling-reference",
            "profiling-scheduler-cps-intelligent-system",
            "codes_2026",
            "tensor_rt",
        )

    def _blackwell_resolve_path(path_value):
        path_text = str(path_value).strip()
        expanded = os.path.expanduser(path_text)
        if os.path.isabs(expanded):
            return expanded

        for root in [os.getcwd(), _blackwell_project_root(), _blackwell_tensor_rt_reference_dir()]:
            candidate = os.path.abspath(os.path.join(root, expanded))
            if os.path.exists(candidate):
                return candidate
        return os.path.abspath(os.path.join(_blackwell_project_root(), expanded))

    def _blackwell_model_source(path_value):
        resolved = _blackwell_resolve_path(path_value)
        return resolved if os.path.exists(resolved) else str(path_value)

    def _blackwell_yolo12_device():
        device = os.environ.get("BLACKWELL_YOLO12_DEVICE", "0")
        return int(device) if str(device).isdigit() else device

    def _blackwell_yolo12_conf():
        return float(os.environ.get("BLACKWELL_YOLO12_CONF", "0.7"))

    def _blackwell_yolo12_imgsz():
        return int(os.environ.get("BLACKWELL_YOLO12_IMGSZ", "640"))

    def _blackwell_yolo12_half():
        return os.environ.get("BLACKWELL_YOLO12_HALF", "1").lower() not in ["0", "false", "no"]

    def _blackwell_yolo12_disable_trt_export():
        return os.environ.get("BLACKWELL_YOLO12_DISABLE_TRT_EXPORT", "0").lower() in ["1", "true", "yes"]

    def _blackwell_find_yolo12_images():
        image_folder = os.environ.get("BLACKWELL_YOLO12_IMAGE_FOLDER", blackwell_yolo12_default_image_folder)
        folder = _blackwell_resolve_path(image_folder)
        if not os.path.isdir(folder):
            return []

        paths = []
        for name in os.listdir(folder):
            if name.lower().endswith((".jpg", ".jpeg", ".png")):
                paths.append(os.path.join(folder, name))
        paths.sort()
        return paths

    def _blackwell_next_yolo12_input(imgsz):
        global _blackwell_yolo12_image_index

        if len(_blackwell_yolo12_image_paths) == 0:
            import numpy as np
            return np.zeros((imgsz, imgsz, 3), dtype=np.uint8), "synthetic-zero-image"

        path = _blackwell_yolo12_image_paths[_blackwell_yolo12_image_index % len(_blackwell_yolo12_image_paths)]
        _blackwell_yolo12_image_index += 1
        return path, path

    def _load_blackwell_yolo12():
        global _blackwell_yolo12_model
        global _blackwell_yolo12_image_paths

        if _blackwell_yolo12_model is not None:
            return _blackwell_yolo12_model

        from ultralytics import YOLO

        weights_value = os.environ.get("BLACKWELL_YOLO12_WEIGHTS", blackwell_yolo12_default_weights)
        engine_value = os.environ.get("BLACKWELL_YOLO12_ENGINE", blackwell_yolo12_default_engine)
        engine_path = _blackwell_resolve_path(engine_value)
        weights_source = _blackwell_model_source(weights_value)
        imgsz = _blackwell_yolo12_imgsz()
        device = _blackwell_yolo12_device()
        backend = "TensorRT"

        if os.path.exists(engine_path):
            model_source = engine_path
            _blackwell_yolo12_model = YOLO(model_source)
        elif _blackwell_yolo12_disable_trt_export():
            model_source = weights_source
            backend = "PyTorch"
            print(
                f"Blackwell: BLACKWELL_YOLO12_DISABLE_TRT_EXPORT is enabled; loading YOLO12 weights from {weights_source}",
                flush=True,
            )
            _blackwell_yolo12_model = YOLO(model_source)
        else:
            print(f"Blackwell: Exporting YOLO12 TensorRT engine from {weights_source}", flush=True)
            pt_model = YOLO(weights_source)
            try:
                exported = pt_model.export(
                    format="engine",
                    imgsz=imgsz,
                    half=_blackwell_yolo12_half(),
                    device=device,
                )
                model_source = str(exported)
                _blackwell_yolo12_model = YOLO(model_source)
            except BaseException as exc:
                message = str(exc)
                trt11_explicit_batch_error = "NetworkDefinitionCreationFlag" in message and "EXPLICIT_BATCH" in message
                if not trt11_explicit_batch_error:
                    raise
                backend = "PyTorch"
                model_source = weights_source
                print(
                    "Blackwell: TensorRT export failed due to TensorRT API mismatch "
                    "(missing EXPLICIT_BATCH). Falling back to PyTorch weights. "
                    "Set BLACKWELL_YOLO12_DISABLE_TRT_EXPORT=1 to skip export attempts.",
                    flush=True,
                )
                _blackwell_yolo12_model = YOLO(model_source)

        _blackwell_yolo12_image_paths = _blackwell_find_yolo12_images()
        warmup = int(os.environ.get("BLACKWELL_YOLO12_WARMUP", "1"))
        for _ in range(max(0, warmup)):
            sample_input, _ = _blackwell_next_yolo12_input(imgsz)
            _blackwell_yolo12_model(sample_input, conf=_blackwell_yolo12_conf(), device=device, verbose=False)

        print(
            f"Blackwell: YOLO12 model ready from {model_source}; backend={backend}, "
            f"images={len(_blackwell_yolo12_image_paths)}",
            flush=True,
        )
        return _blackwell_yolo12_model

    def _execute_blackwell_yolo12_task(reactor, task):
        with _blackwell_yolo12_lock:
            model = _load_blackwell_yolo12()
            imgsz = _blackwell_yolo12_imgsz()
            device = _blackwell_yolo12_device()
            input_source, input_label = _blackwell_next_yolo12_input(imgsz)

            start_ns = time.perf_counter_ns()
            results = model(input_source, conf=_blackwell_yolo12_conf(), device=device, verbose=False)
            end_ns = time.perf_counter_ns()

        inference_ms = int((end_ns - start_ns) / 1_000_000)
        first_result = results[0] if len(results) > 0 else None
        speed = dict(getattr(first_result, "speed", {}) or {}) if first_result is not None else {}
        detection_count = 0
        if first_result is not None and getattr(first_result, "boxes", None) is not None:
            detection_count = len(first_result.boxes)

        task.yolo12_input = input_label
        task.yolo12_inference_ms = inference_ms
        task.yolo12_speed = speed
        task.yolo12_detection_count = detection_count
        reactor.yolo_results[task.index] = {
            "input": input_label,
            "inference_ms": inference_ms,
            "speed": speed,
            "detections": detection_count,
        }
        if reactor.current_packet is not None:
            reactor.current_packet["yolo12_input"] = input_label
            reactor.current_packet["yolo12_inference_ms"] = inference_ms
            reactor.current_packet["yolo12_speed"] = speed
            reactor.current_packet["yolo12_detection_count"] = detection_count

        print(
            f"{reactor.device_name}: YOLO12 inference for {task.name}: "
            f"{inference_ms} ms, detections={detection_count}, input={input_label}",
            flush=True,
        )

    def _load_cloudlet_llm():
        global _cloudlet_llm_tokenizer
        global _cloudlet_llm_model
        global _cloudlet_llm_generation
        global _cloudlet_llm_has_cuda
        global _cloudlet_llm_torch

        if _cloudlet_llm_model is not None:
            return

        import torch
        from transformers import AutoTokenizer, AutoModelForCausalLM, BitsAndBytesConfig

        model_id = os.environ.get("CLOUDLET_LLM_MODEL_ID", cloudlet_llm_default_model_id)
        has_cuda = torch.cuda.is_available()
        dtype = torch.bfloat16 if has_cuda else torch.float32

        print(f"Blackwell: Loading 7B LLM model {model_id}", flush=True)
        if not has_cuda:
            print("Blackwell: CUDA is not available; loading LLM on CPU.", flush=True)

        tokenizer = AutoTokenizer.from_pretrained(model_id, use_fast=True)
        if tokenizer.pad_token_id is None:
            tokenizer.pad_token = tokenizer.eos_token

        common = dict(
            device_map="auto" if has_cuda else None,
            dtype=dtype,
            low_cpu_mem_usage=True,
        )

        use_4bit = has_cuda and os.environ.get("CLOUDLET_LLM_DISABLE_4BIT", "0").lower() not in ["1", "true", "yes"]
        if use_4bit:
            try:
                import bitsandbytes as bnb
                common["quantization_config"] = BitsAndBytesConfig(
                    load_in_4bit=True,
                    bnb_4bit_quant_type="nf4",
                    bnb_4bit_use_double_quant=True,
                    bnb_4bit_compute_dtype=dtype,
                )
            except Exception as exc:
                print(f"Blackwell: bitsandbytes unavailable; loading LLM without 4-bit quantization: {exc}", flush=True)

        model = AutoModelForCausalLM.from_pretrained(model_id, **common)
        model.eval()

        max_new_tokens = int(os.environ.get("CLOUDLET_LLM_MAX_NEW_TOKENS", "24"))
        use_kv_cache = os.environ.get("CLOUDLET_LLM_USE_KV_CACHE", "0").lower() in ["1", "true", "yes"]
        _cloudlet_llm_tokenizer = tokenizer
        _cloudlet_llm_model = model
        _cloudlet_llm_generation = dict(
            max_new_tokens=max_new_tokens,
            do_sample=False,
            use_cache=use_kv_cache,
            eos_token_id=tokenizer.eos_token_id,
            pad_token_id=tokenizer.pad_token_id,
        )
        _cloudlet_llm_has_cuda = has_cuda
        _cloudlet_llm_torch = torch
        print("Blackwell: 7B LLM model ready.", flush=True)

    def _run_cloudlet_llm(question):
        with _cloudlet_llm_lock:
            _load_cloudlet_llm()

            prompt = f"You are a concise Q&A assistant.\n\nQuestion: {question}\nAnswer:"
            inputs = _cloudlet_llm_tokenizer(prompt, return_tensors="pt")
            if _cloudlet_llm_has_cuda:
                inputs = {k: v.to("cuda") for k, v in inputs.items()}
                _cloudlet_llm_torch.cuda.synchronize()

            with _cloudlet_llm_torch.inference_mode():
                output = _cloudlet_llm_model.generate(**inputs, **_cloudlet_llm_generation)

            if _cloudlet_llm_has_cuda:
                _cloudlet_llm_torch.cuda.synchronize()

            prompt_len = inputs["input_ids"].shape[1]
            result = _cloudlet_llm_tokenizer.decode(output[0][prompt_len:], skip_special_tokens=True)

            del output
            del inputs
            gc.collect()
            if _cloudlet_llm_has_cuda:
                _cloudlet_llm_torch.cuda.empty_cache()

        text = result.strip()
        for sep in ["\n", ". ", "  "]:
            idx = text.find(sep)
            if idx > 0:
                text = text[:idx]
                break
        return text.strip().strip(":").strip()

    def _execute_cloudlet_llm_task(reactor, task):
        question = getattr(task, "llm_question", None) or cloudlet_llm_default_question
        start_ns = time.perf_counter_ns()
        answer = _run_cloudlet_llm(question)
        end_ns = time.perf_counter_ns()
        inference_ms = int((end_ns - start_ns) / 1_000_000)

        task.llm_question = question
        task.llm_answer = answer
        task.llm_inference_ms = inference_ms
        reactor.llm_results[task.index] = {
            "question": question,
            "answer": answer,
            "inference_ms": inference_ms,
        }
        if reactor.current_packet is not None:
            reactor.current_packet["llm_question"] = question
            reactor.current_packet["llm_answer"] = answer
            reactor.current_packet["llm_inference_ms"] = inference_ms

        print(f"{reactor.device_name}: LLM question for {task.name}: {question}", flush=True)
        print(f"{reactor.device_name}: LLM answer for {task.name}: {answer} ({inference_ms} ms)", flush=True)

=}

reactor CloudletNetworkReceiver(receiver_device_index = 2, receiver_device_name = "Blackwell") {
    state pending_packets
    state bandwidth = []
    state latency = []

    input network_info
    input recv_mobile_robot
    input recv_edge

    logical action comm_delay_mobile_robot
    logical action comm_delay_edge

    output forward_mobile_robot
    output forward_edge

    reaction(startup) {=
        self.pending_packets = {"mobile_robot": [], "edge": []}
        self.bandwidth = []
        self.latency = []
    =}

    reaction(network_info) {=
        _apply_network_info(self, network_info.value)
    =}

    reaction(recv_mobile_robot, recv_edge) -> comm_delay_mobile_robot, comm_delay_edge {=
        if recv_mobile_robot.is_present:
            _queue_network_receiver_packet(self, "mobile_robot", recv_mobile_robot.value, comm_delay_mobile_robot)

        if recv_edge.is_present:
            _queue_network_receiver_packet(self, "edge", recv_edge.value, comm_delay_edge)
    =}

    reaction(comm_delay_mobile_robot) -> forward_mobile_robot {=
        packet = _pop_ready_network_receiver_packet(self, "mobile_robot", comm_delay_mobile_robot)
        if packet is not None:
            forward_mobile_robot.set(packet)
    =}

    reaction(comm_delay_edge) -> forward_edge {=
        packet = _pop_ready_network_receiver_packet(self, "edge", comm_delay_edge)
        if packet is not None:
            forward_edge.set(packet)
    =}
}

reactor Blackwell(device_index = 2, device_name = "Blackwell") {
    state task_queue = []
    state current_packet
    state pending_task_packets
    state received_parent_indexes
    state completed_task_indexes = []
    state trace_events = []
    state current_comp_start_time = 0.0
    state pending_packets = []
    state llm_results
    state yolo_results
    state llm_thread
    state llm_error

    input network_info
    input task_chains
    input recv_mobile_robot
    input recv_edge

    logical action start_execution
    logical action end_execution
    logical action send_packet
    physical action llm_done

    output send_mobile_robot
    output send_edge
    output final_output
    output trace_output

    nr = new CloudletNetworkReceiver()
    network_info -> nr.network_info
    recv_mobile_robot -> nr.recv_mobile_robot
    recv_edge -> nr.recv_edge

    reaction(startup) {=
        self.task_queue = []
        self.current_packet = None
        self.pending_task_packets = {}
        self.received_parent_indexes = {}
        self.completed_task_indexes = set()
        self.trace_events = []
        self.pending_packets = []
        self.llm_results = {}
        self.yolo_results = {}
        self.llm_thread = None
        self.llm_error = None
    =}

    reaction(start_execution) -> end_execution, llm_done {=
        if self.current_packet is None:
            return

        elapsed_logical_time = lf.time.logical_elapsed()
        elapsed_physical_time = lf.time.physical_elapsed()
        self.current_comp_start_time = elapsed_physical_time / 1e9

        task = self.current_packet["task"]
        print(f"{self.device_name}: Execute task {task.name}")
        print(f"{self.device_name}: Tag = ({elapsed_logical_time}, {lf.tag().microstep}) "
              f"and physical time = {elapsed_physical_time}")
        exec_time_ms = task.execution_times[self.device_index]
        if _is_llm_task(task):
            self.llm_error = None

            def worker():
                try:
                    _execute_cloudlet_llm_task(self, task)
                except BaseException as exc:
                    self.llm_error = exc
                    print(f"{self.device_name}: LLM task {task.name} failed: {exc}", flush=True)
                finally:
                    llm_done.schedule(0)

            self.llm_thread = threading.Thread(target=worker, daemon=True)
            self.llm_thread.start()
        elif _is_vit_task(task):
            try:
                _execute_blackwell_yolo12_task(self, task)
            except BaseException as exc:
                print(f"{self.device_name}: YOLO12 task {task.name} failed: {exc}", flush=True)
                request_stop()
                return
            end_execution.schedule(0)
        else:
            time.sleep(exec_time_ms / 1000.0 / time_unit)
            end_execution.schedule(MSEC(int(exec_time_ms)))
    =} deadline(10 sec) {=
        print(f"In {self.device_name}'s deadline handler.")
        elapsed_logical_time = lf.time.logical_elapsed()
        elapsed_physical_time = lf.time.physical_elapsed()
        print(f"Logical time = {elapsed_logical_time} and physical time = {elapsed_physical_time}")
    =}

    reaction(llm_done) -> end_execution {=
        if self.current_packet is None:
            return
        self.llm_thread = None
        if self.llm_error is not None:
            request_stop()
            return
        end_execution.schedule(0)
    =}

    reaction(end_execution) -> start_execution, send_packet, final_output, trace_output {=
        if self.current_packet is None:
            return

        completed_packet = self.current_packet
        completed_task = completed_packet["task"]
        task_index = completed_task.index
        end_time_sec = lf.time.physical_elapsed() / 1e9
        end_ms = end_time_sec * 1000.0
        deadline_ms = int(completed_task.deadline) if completed_task.deadline is not None else -1
        deadline_met = True if deadline_ms <= 0 else (end_ms <= float(deadline_ms))

        self.trace_events.append({
            "type": "comp",
            "task_name": completed_task.name,
            "device_index": self.device_index,
            "device_name": self.device_name,
            "start_time": self.current_comp_start_time,
            "end_time": end_time_sec,
            "deadline_ms": deadline_ms,
            "deadline_met": deadline_met
        })

        self.completed_task_indexes.add(task_index)
        self.pending_task_packets.pop(task_index, None)
        self.received_parent_indexes.pop(task_index, None)
        self.current_packet = None

        for continuation in completed_packet.get("continuations", []):
            next_packet = dict(continuation)
            next_packet["parent_task"] = completed_task
            if _is_llm_task(completed_task):
                next_packet["parent_llm_answer"] = getattr(completed_task, "llm_answer", None)
            destination_device = next_packet.get("device")

            if destination_device == self.device_index:
                _accept_chain_packet(self, next_packet)
                continue

            next_packet["payload_size"] = completed_task.output_size
            self.pending_packets.append(next_packet)
            print(f"{self.device_name}: Forwarding task {next_packet['task'].name} to device {destination_device}")

        if len(self.pending_packets) > 0:
            send_packet.schedule(0)
        final_output.set(completed_task)
        trace_output.set(self.trace_events)
        _schedule_next_chain_task(self, start_execution)
    =}

    reaction(send_packet) -> send_mobile_robot, send_edge, send_packet {=
        if len(self.pending_packets) == 0:
            return

        now_sec = lf.time.physical_elapsed() / 1e9
        packet = self.pending_packets.pop(0)
        destination_device = packet.get("device") if isinstance(packet, dict) else None
        if isinstance(packet, dict):
            packet["sender_device"] = self.device_index
            packet["sent_time_sec"] = now_sec
        if destination_device == 0:
            send_mobile_robot.set(packet)
        elif destination_device == 1:
            send_edge.set(packet)
        else:
            print(f"{self.device_name}: Error - invalid direct destination {destination_device}")

        if len(self.pending_packets) > 0:
            send_packet.schedule(0)
    =}

    reaction(task_chains) -> start_execution, send_packet, trace_output {=
        self.task_queue = []
        self.current_packet = None
        self.pending_task_packets = {}
        self.received_parent_indexes = {}
        self.completed_task_indexes = set()
        self.trace_events = []
        self.pending_packets = []
        self.llm_results = {}
        self.yolo_results = {}
        self.llm_thread = None
        self.llm_error = None

        chains = task_chains.value if task_chains.is_present and isinstance(task_chains.value, list) else []
        print(f"{self.device_name}: Received {len(chains)} initial chain packet(s).")

        for packet in chains:
            if isinstance(packet, dict) and packet.get("device") == self.device_index:
                _accept_chain_packet(self, packet)
            else:
                if isinstance(packet, dict) and "task" in packet and "device" in packet:
                    task = packet["task"]
                    destination_device = packet["device"]
                    packet["payload_size"] = task.input_size
                    print(f"{self.device_name}: Forwarding input data for task {task.name} "
                          f"to device {destination_device}")
                self.pending_packets.append(packet)

        if len(self.pending_packets) > 0:
            send_packet.schedule(0)
        _schedule_next_chain_task(self, start_execution)
        trace_output.set(self.trace_events)
    =}

    reaction(nr.forward_mobile_robot, nr.forward_edge) -> start_execution, send_packet {=
        packets = []
        if nr.forward_mobile_robot.is_present:
            packets.append(nr.forward_mobile_robot.value)
        if nr.forward_edge.is_present:
            packets.append(nr.forward_edge.value)

        for packet in packets:
            if isinstance(packet, dict) and packet.get("device") == self.device_index:
                _record_arrived_packet(self, packet)
                _accept_chain_packet(self, packet)
            else:
                self.pending_packets.append(packet)

        if len(self.pending_packets) > 0:
            send_packet.schedule(0)
        _schedule_next_chain_task(self, start_execution)
    =}
}
