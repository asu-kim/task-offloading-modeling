target Python
preamble {=
    import time
    from pathlib import Path
    import math
    import pandas as pd

    PROJECT_ROOT = Path(__file__).resolve().parents[2]

    def project_path(*parts):
        return str(PROJECT_ROOT.joinpath(*parts))

    def transfer_time_ms(data_size_mb: float, bandwidth_mb_per_sec: int) -> int:
        if data_size_mb == 0 or bandwidth_mb_per_sec == 0:
            return 0
        return int(math.ceil(float(data_size_mb) / float(bandwidth_mb_per_sec)))
=}

reactor ComputeDevice(
    device_index = 0,
    device_type_index = 0,
    device_name = "Jetson",
    bandwidth_csv_path = "Bandwidth.csv",
    fast_enable = True
) {
    state task_queue = []
    state current_task_index = 0
    state comm_map
    state trace_events = []
    state current_comp_start_time = 0.0
    state input_data
    state pending_packets = []
    state bandwidth = []
    state sender_trace_next_sec = 0.0

    input tasks_to_run
    input communication_map
    input in_port
    logical action start_execution
    logical action end_execution
    logical action send_packet
    output out_port
    output final_output
    output trace_output

    reaction(startup) {=
        self.input_data = {}
        self.sender_trace_next_sec = 0.0
        comm_df = pd.read_csv(project_path(self.bandwidth_csv_path), index_col=0)
        comm_df.columns = comm_df.columns.str.strip()
        comm_df.index = comm_df.index.str.strip()
        n = len(comm_df.columns)
        self.bandwidth = [[0] * n for _ in range(n)]
        for i in range(n):
            for j in range(n):
                value = comm_df.iloc[i, j]
                self.bandwidth[i][j] = int(value) if not pd.isna(value) else 0
    =}

    reaction(tasks_to_run, communication_map) -> start_execution, send_packet, trace_output {=
        self.task_queue = tasks_to_run.value
        self.comm_map = communication_map.value if communication_map.is_present else {}
        self.current_task_index = 0
        self.trace_events = []
        self.pending_packets = []
        self.sender_trace_next_sec = 0.0
        self.input_data = {}

        for task in self.task_queue:
            self.input_data[task.name] = False
            if len(task.parent_task_indexes) == 0 and task.source_device_index == self.device_index:
                self.input_data[task.name] = True

        if isinstance(self.comm_map, dict):
            for task_index, comm_entries in self.comm_map.items():
                if isinstance(comm_entries, dict) and "source_input" in comm_entries:
                    comm_info = comm_entries["source_input"]
                    destination_device = comm_info["destination_device"]
                    child_task = comm_info["child_task"]
                    input_size = comm_info.get("input_size", 0)
                    bw = self.bandwidth[self.device_index][destination_device] if self.bandwidth else 0
                    transfer_ms = transfer_time_ms(input_size, bw) if bw > 0 else 0
                    trace_send_time_sec = max(self.sender_trace_next_sec, lf.time.logical_elapsed() / 1e9)
                    self.trace_events.append({
                        "type": "comm_send",
                        "task_name": child_task.name,
                        "from_device": self.device_index,
                        "to_device": destination_device,
                        "start_time": trace_send_time_sec,
                        "output_size": input_size
                    })
                    self.sender_trace_next_sec = trace_send_time_sec + (transfer_ms / 1000.0)
                    self.pending_packets.append({
                        "destination_device": destination_device,
                        "child_task": child_task,
                        "parent_task": None,
                        "input_size": input_size,
                        "is_source_input": True
                    })

        if len(self.pending_packets) > 0:
            send_packet.schedule(0)

        if len(self.task_queue) == 0:
            trace_output.set(self.trace_events)
            return

        task = self.task_queue[self.current_task_index]
        if self.input_data.get(task.name, False):
            start_execution.schedule(0)
    =}

    reaction(in_port) -> start_execution {=
        packet = in_port.value
        if isinstance(packet, dict) and "child_task" in packet:
            child_task = packet["child_task"]
            task_name = child_task.name
            self.input_data[task_name] = True
            for i, queued_task in enumerate(self.task_queue):
                if queued_task.name == task_name and queued_task.index == child_task.index and i == self.current_task_index:
                    start_execution.schedule(0)
                    break
        else:
            task = packet
            if self.input_data.get(task.name, False):
                start_execution.schedule(0)
    =}

    reaction(start_execution) -> end_execution {=
        if self.current_task_index >= len(self.task_queue):
            return
        task = self.task_queue[self.current_task_index]
        if not self.input_data.get(task.name, False):
            return
        elapsed_logical_time = lf.time.logical_elapsed()
        self.current_comp_start_time = elapsed_logical_time / 1e9
        exec_time_ms = task.execution_times[self.device_type_index]
        if self.fast_enable != True:
            time.sleep(exec_time_ms / 1000.0)
        end_execution.schedule(MSEC(int(exec_time_ms)))
    =}

    reaction(end_execution) -> start_execution, send_packet, final_output, trace_output {=
        completed_task = self.task_queue[self.current_task_index]
        task_index = completed_task.index
        end_time_sec = lf.time.logical_elapsed() / 1e9
        end_ms = end_time_sec * 1000.0
        deadline_ms = int(completed_task.deadline) if completed_task.deadline is not None else -1
        deadline_met = True if deadline_ms <= 0 else (end_ms <= float(deadline_ms))

        self.trace_events.append({
            "type": "comp",
            "task_name": completed_task.name,
            "device_index": self.device_index,
            "device_name": self.device_name,
            "start_time": self.current_comp_start_time,
            "end_time": end_time_sec,
            "deadline_ms": deadline_ms,
            "deadline_met": deadline_met
        })

        if task_index in self.comm_map:
            for child_index, comm_info in self.comm_map[task_index].items():
                destination_device = comm_info["destination_device"]
                child_task = comm_info["child_task"]
                output_size = comm_info["output_size"]
                bw = self.bandwidth[self.device_index][destination_device] if self.bandwidth else 0
                transfer_ms = transfer_time_ms(output_size, bw) if bw > 0 else 0
                trace_send_time_sec = max(self.sender_trace_next_sec, end_time_sec)
                self.trace_events.append({
                    "type": "comm_send",
                    "task_name": child_task.name,
                    "from_device": self.device_index,
                    "to_device": destination_device,
                    "start_time": trace_send_time_sec,
                    "output_size": output_size
                })
                self.sender_trace_next_sec = trace_send_time_sec + (transfer_ms / 1000.0)
                self.pending_packets.append({
                    "destination_device": destination_device,
                    "child_task": child_task,
                    "parent_task": completed_task,
                    "output_size": output_size
                })

        if len(self.pending_packets) > 0:
            send_packet.schedule(0)

        if completed_task.child_task_indexes:
            for child_task_index in completed_task.child_task_indexes:
                for queued_task in self.task_queue:
                    if child_task_index == queued_task.index:
                        self.input_data[queued_task.name] = True

        self.current_task_index += 1
        if self.current_task_index >= len(self.task_queue):
            trace_output.set(self.trace_events)
        else:
            task = self.task_queue[self.current_task_index]
            if self.input_data.get(task.name, False):
                start_execution.schedule(0)
    =}

    reaction(send_packet) -> out_port, send_packet {=
        if len(self.pending_packets) == 0:
            return
        packet = self.pending_packets.pop(0)
        out_port.set(packet)
        if len(self.pending_packets) > 0:
            send_packet.schedule(0)
    =}
}
