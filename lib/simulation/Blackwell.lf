target Python
preamble {=
    import time
    from pathlib import Path
    time_unit = 1
=}

reactor Blackwell(device_index = 2, device_name = "Blackwell", fast_enable = True) {
    // state execution_time = [3, 5]
    state task_queue = []
    state tasks = []
    state current_task_index = 0
    state comm_map // Communication map: {task_index: {child_index: {destination_device, child_task, output_size}}}
    state trace_events = []
    state current_comp_start_time = 0.0
    input tasks_to_run
    input communication_map
    input in_port
    // input recv_a6000
    // input recv_agx
    logical action start_execution
    logical action end_execution
    logical action send_packet
    // output send_a6000
    // output send_agx
    output out_port

    state input_data
    state output_data
    state pending_packets = []
    state bandwidth = []
    state sender_trace_next_sec = 0.0

    reaction(startup) {=
        self.sender_trace_next_sec = 0.0
        bandwidth_csv_path = str(Path(__file__).resolve().parents[2] / "Bandwidth.csv")
        comm_df = pd.read_csv(bandwidth_csv_path, index_col=0)
        comm_df.columns = comm_df.columns.str.strip()
        comm_df.index = comm_df.index.str.strip()
        n = len(comm_df.columns)
        self.bandwidth = [[0] * n for _ in range(n)]
        for i in range(n):
            for j in range(n):
                v = comm_df.iloc[i, j]
                self.bandwidth[i][j] = int(v) if not pd.isna(v) else 0
    =}
    output final_output
    output trace_output

    reaction(tasks_to_run, communication_map) -> start_execution, trace_output {=
        self.input_data = {"VIT1": False, "VIT2": False, "LLM1": False, "LLM2": False}
        self.output_data = {"VIT1": None, "VIT2": None, "LLM1": False, "LLM2": False}

        # Receive the tasks to run and communication map
        # Schedule the communication as well
        print("In Blackwell")
        self.task_queue = tasks_to_run.value
        self.comm_map = communication_map.value if communication_map.is_present else {}
        print(self.task_queue)
        print(f"Blackwell communication map: {self.comm_map}")
        print("")

        if len(self.task_queue) == 0:
            trace_output.set(self.trace_events)
            return

        # Schedule execution if input data is ready
        task = self.task_queue[self.current_task_index]
        task_name = task.name
        if self.input_data[task_name] is True:
            # schedule
            print(f"Blackwell: Schedule task {task_name} at logical time {lf.time.logical_elapsed()}")
            start_execution.schedule(0)
    =}

    // reaction(recv_agx, recv_blackwell) {=
    //     # TODO: run the scheduled tasks when the input data is coming.
    //     # if not task_name.is_present or not input_data.is_present:
    //     #     sys.stderr.write("ERROR: Both should be present.\n")
    //     #     exit(1)
    // =}

    reaction(in_port) -> start_execution {=
        # Handle incoming communication packet
        packet = in_port.value
        
        if isinstance(packet, dict) and "child_task" in packet:
            # This is a communication packet from another device
            child_task = packet["child_task"]
            parent_task = packet.get("parent_task")
            is_source_input = packet.get("is_source_input", False)
            task_name = child_task.name
            
            if is_source_input:
                print(f"Blackwell: Received initial input data for source task {task_name}")
            else:
                print(f"Blackwell: Received output from parent task {parent_task.name if parent_task else 'unknown'} "
                      f"for child task {task_name}")
            
            # Mark that input data is ready for this child task
            if task_name not in self.input_data:
                self.input_data[task_name] = False
            self.input_data[task_name] = True
            
            # Check if this task is in our queue and ready to execute
            for i, queued_task in enumerate(self.task_queue):
                if queued_task.name == task_name and queued_task.index == child_task.index:
                    # Found the task in queue, check if we should schedule it
                    if self.input_data[task_name] is True:
                        # Make sure we're at the right position or update current_task_index
                        if i == self.current_task_index:
                            print(f"Blackwell: Scheduling task {task_name} at logical time {lf.time.logical_elapsed()}")
                            start_execution.schedule(0)
                        break
        else:
            # Legacy format: assume it's a task object directly
            task = packet
            task_name = task.name
            if task_name in self.input_data and self.input_data[task_name] is True:
                print(f"Blackwell: Schedule task {task_name} at logical time {lf.time.logical_elapsed()}")
                start_execution.schedule(0)
    =}

    reaction(start_execution) -> end_execution {=
        elapsed_logical_time = lf.time.logical_elapsed()
        self.current_comp_start_time = elapsed_logical_time / 1e9  # logical time to seconds
        elapsed_physicl_time = lf.time.physical_elapsed()
        # Keep execution deterministic for trace generation; do not tighten runtime deadline dynamically.

        task = self.task_queue[self.current_task_index]
        print(f"Blackwell: Execute task {task.name}")
        print(f"Blackwell: Tag = ({elapsed_logical_time}, {lf.tag().microstep}) and physical time = {elapsed_physicl_time}")
        exec_time_ms = task.execution_times[self.device_index]
        if self.fast_enable != True:
            time.sleep(exec_time_ms / 1000.0 / time_unit)
        # self.check_deadline()
        end_execution.schedule(MSEC(int(exec_time_ms)))
        # self.update_deadline(FOREVER)
    =} deadline(10 sec) {=
        print("In Blackwell's deadline handler.")
        elapsed_logical_time = lf.time.logical_elapsed()
        elapsed_physicl_time = lf.time.physical_elapsed()
        print(f"Logical time = {elapsed_logical_time} and physical time = {elapsed_physicl_time}")
    =}

    reaction(end_execution) -> start_execution, send_packet, final_output, trace_output {=
        # Get the completed task
        completed_task = self.task_queue[self.current_task_index]
        task_index = completed_task.index
        end_time_sec = lf.time.logical_elapsed() / 1e9
        end_ms = end_time_sec * 1000.0
        deadline_ms = int(completed_task.deadline) if completed_task.deadline is not None else -1
        deadline_met = True if deadline_ms <= 0 else (end_ms <= float(deadline_ms))

        # Record computation segment in trace
        self.trace_events.append({
            "type": "comp",
            "task_name": completed_task.name,
            "device_index": self.device_index,
            "device_name": self.device_name,
            "start_time": self.current_comp_start_time,
            "end_time": end_time_sec,
            "deadline_ms": deadline_ms,
            "deadline_met": deadline_met
        })

        # Check if this task needs to send outputs to child tasks on other devices
        if task_index in self.comm_map:
            # Send outputs to each child task on different devices
            for child_index, comm_info in self.comm_map[task_index].items():
                destination_device = comm_info["destination_device"]
                child_task = comm_info["child_task"]
                output_size = comm_info["output_size"]
                
                bw = self.bandwidth[self.device_index][destination_device] if self.bandwidth else 0
                transfer_ms = transfer_time_ms(output_size, bw) if bw > 0 else 0
                trace_send_time_sec = max(self.sender_trace_next_sec, end_time_sec)

                # Record communication send in trace
                self.trace_events.append({
                    "type": "comm_send",
                    "task_name": child_task.name,
                    "from_device": self.device_index,
                    "to_device": destination_device,
                    "start_time": trace_send_time_sec,
                    "output_size": output_size
                })
                self.sender_trace_next_sec = trace_send_time_sec + (transfer_ms / 1000.0)

                # Create a communication packet: [destination_device_index, task_data]
                # The NetworkFabric will route this to the correct device
                comm_packet = {
                    "destination_device": destination_device,
                    "child_task": child_task,
                    "parent_task": completed_task,
                    "output_size": output_size
                }

                print(f"Blackwell: Task {completed_task.name} (index {task_index}) completed. "
                      f"Sending output to child task {child_task.name} (index {child_index}) "
                      f"on device {destination_device}")
                self.pending_packets.append(comm_packet)

        if len(self.pending_packets) > 0:
            send_packet.schedule(0)

        # Mark input data ready for any child tasks that are in this device's task_queue
        if completed_task.child_task_indexes:
            for child_task_index in completed_task.child_task_indexes:
                for queued_task in self.task_queue:
                    if child_task_index == queued_task.index:
                        self.input_data[queued_task.name] = True
        
        self.current_task_index += 1

        if self.current_task_index >= len(self.task_queue):
            print(f"Blackwell: finish executing all scheduled tasks")
            trace_output.set(self.trace_events)
        else:
            # Schedule next execution if input data is ready
            task = self.task_queue[self.current_task_index]
            task_name = task.name
            if self.input_data[task_name] is True:
                # schedule
                print(f"Schedule task {task_name} at logical time {lf.time.logical_elapsed()}")
                start_execution.schedule(0)
    =}

    reaction(send_packet) -> out_port, send_packet {=
        if len(self.pending_packets) == 0:
            return
        packet = self.pending_packets.pop(0)
        out_port.set(packet)
        if len(self.pending_packets) > 0:
            send_packet.schedule(0)
    =}
}
