target Python
preamble {=
    import time
=}

reactor AGX(device_index = 0) {
    // state execution_time = [4, 8]
    state task_queue = []
    state tasks = []
    state current_task_index = 0
    state comm_map  // Communication map: {task_index: {child_index: {destination_device, child_task, output_size}}}
    input tasks_to_run
    input communication_map
    input in_port
    // input recv_a6000
    // input recv_blackwell
    logical action start_execution
    logical action end_execution
    // output send_a6000
    // output send_blackwell
    output out_port

    state input_data
    state output_data

    reaction(startup) {=
        self.input_data = {"I1": True, "I2": True, "L1": False, "L2": False}
        self.output_data = {"I1": None, "I2": None, "L1": False, "L2": False}
    =}

    reaction(tasks_to_run, communication_map) -> start_execution, out_port {=
        # Receive the tasks to run and communication map
        # Schedule the communication as well
        print("In AGX")
        self.task_queue = tasks_to_run.value
        self.comm_map = communication_map.value if communication_map.is_present else {}
        print(self.task_queue)
        print(f"AGX communication map: {self.comm_map}")
        print("")

        # Schedule execution if input data is ready
        task = self.task_queue[self.current_task_index]
        print(f"current task's child tasks = {task.child_task_indexes}")
        task_name = task.name
        if self.input_data[task_name] is True:
            # schedule
            print(f"AGX: Schedule task {task_name} at logical time {lf.time.logical_elapsed()}")
            start_execution.schedule(0)
    =}

    // reaction(recv_a6000, recv_blackwell) {=
    //     # if not task_name.is_present or not input_data.is_present:
    //     #     sys.stderr.write("ERROR: Both should be present.\n")
    //     #     exit(1)
    // =}

    reaction(in_port) -> start_execution {=
        # Handle incoming communication packet
        packet = in_port.value
        
        if isinstance(packet, dict) and "child_task" in packet:
            # This is a communication packet from another device
            child_task = packet["child_task"]
            parent_task = packet.get("parent_task")
            task_name = child_task.name
            
            print(f"AGX: Received output from parent task {parent_task.name if parent_task else 'unknown'} "
                  f"for child task {task_name}")
            
            # Mark that input data is ready for this child task
            if task_name not in self.input_data:
                self.input_data[task_name] = False
            self.input_data[task_name] = True
            
            # Check if this task is in our queue and ready to execute
            for i, queued_task in enumerate(self.task_queue):
                if queued_task.name == task_name and queued_task.index == child_task.index:
                    # Found the task in queue, check if we should schedule it
                    if self.input_data[task_name] is True:
                        # Make sure we're at the right position or update current_task_index
                        if i == self.current_task_index:
                            print(f"AGX: Scheduling task {task_name} at logical time {lf.time.logical_elapsed()}")
                            start_execution.schedule(0)
                        break
        else:
            # Legacy format: assume it's a task object directly
            task = packet
            task_name = task.name
            if task_name in self.input_data and self.input_data[task_name] is True:
                print(f"AGX: Schedule task {task_name} at logical time {lf.time.logical_elapsed()}")
                start_execution.schedule(0)
    =}

    reaction(start_execution) -> end_execution {=
        elapsed_logical_time = lf.time.logical_elapsed()
        elapsed_physicl_time = lf.time.physical_elapsed()

        task = self.task_queue[self.current_task_index]
        print(f"Execute task {task.name}")
        print(f"Tag = ({elapsed_logical_time}, {lf.tag().microstep}) and physical time = {elapsed_physicl_time}")
        exec_time = task.execution_times[self.device_index]
        time.sleep(exec_time/1000)
        self.check_deadline()
        end_execution.schedule(MSEC(exec_time))
    =} deadline(10 msec) {=
        print("In deadline handler.")
        elapsed_logical_time = lf.time.logical_elapsed()
        elapsed_physicl_time = lf.time.physical_elapsed()
        print(f"Logical time = {elapsed_logical_time} and physical time = {elapsed_physicl_time}")
    =}

    reaction(end_execution) -> start_execution, out_port {=
        # Get the completed task
        completed_task = self.task_queue[self.current_task_index]
        task_index = completed_task.index
        
        # Check if this task needs to send outputs to child tasks on other devices
        if task_index in self.comm_map:
            # Send outputs to each child task on different devices
            for child_index, comm_info in self.comm_map[task_index].items():
                destination_device = comm_info["destination_device"]
                child_task = comm_info["child_task"]
                output_size = comm_info["output_size"]
                
                # Create a communication packet: [destination_device_index, task_data]
                # The NetworkFabric will route this to the correct device
                comm_packet = {
                    "destination_device": destination_device,
                    "child_task": child_task,
                    "parent_task": completed_task,
                    "output_size": output_size
                }
                
                print(f"AGX: Task {completed_task.name} (index {task_index}) completed. "
                      f"Sending output to child task {child_task.name} (index {child_index}) "
                      f"on device {destination_device}")
                out_port.set(comm_packet)
        
        # Schedule next execution if input data is ready
        self.current_task_index += 1

        if self.current_task_index >= len(self.task_queue):
            print(f"AGX: finish executing all scheduled tasks")
        else:
            task = self.task_queue[self.current_task_index]
            task_name = task.name
            if self.input_data[task_name] is True:
                # schedule
                print(f"Schedule task {task_name} at logical time {lf.time.logical_elapsed()}")
                start_execution.schedule(0)
    =}
}