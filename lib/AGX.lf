target Python
preamble {=
    import time
=}

reactor AGX(device_index = 0) {
    // state execution_time = [4, 8]
    state task_queue = []
    state tasks = []
    state current_task_index = 0
    input tasks_to_run
    input in_port
    // input recv_a6000
    // input recv_blackwell
    logical action start_execution
    logical action end_execution
    // output send_a6000
    // output send_blackwell
    output out_port

    state input_data
    state output_data

    reaction(startup) {=
        self.input_data = {"I1": True, "I2": True, "L1": False, "L2": False}
        self.output_data = {"I1": None, "I2": None, "L1": False, "L2": False}
    =}

    reaction(tasks_to_run) -> start_execution {=
        # Receive the tasks to run and set state variable
        # Schedule the communication as well
        print("In AGX")
        self.task_queue = tasks_to_run.value
        print(self.task_queue)
        print("")

        # Schedule execution if input data is ready
        task = self.task_queue[self.current_task_index]
        task_name = task.name
        if self.input_data[task_name] is True:
            # schedule
            print(f"Schedule task {task_name} at logical time {lf.time.logical_elapsed()}")
            start_execution.schedule(0)
    =}

    // reaction(recv_a6000, recv_blackwell) {=
    //     # if not task_name.is_present or not input_data.is_present:
    //     #     sys.stderr.write("ERROR: Both should be present.\n")
    //     #     exit(1)
    // =}

    reaction(in_port) -> start_execution {=
        # Schedule execution if input data is ready
        task = in_port.value
        task_name = task.name
        if self.input_data[task_name] is True:
            # schedule
            print(f"Schedule task {task_name} at logical time {lf.time.logical_elapsed()}")
            start_execution.schedule(0)
    =}

    reaction(start_execution) -> end_execution {=
        elapsed_logical_time = lf.time.logical_elapsed()
        elapsed_physicl_time = lf.time.physical_elapsed()

        task = self.task_queue[self.current_task_index]
        print(f"Execute task {task.name}")
        print(f"Tag = ({elapsed_logical_time}, {lf.tag().microstep}) and physical time = {elapsed_physicl_time}")
        exec_time = task.execution_times[self.device_index]
        time.sleep(exec_time/1000)
        self.check_deadline()
        end_execution.schedule(MSEC(exec_time))
    =} deadline(10 msec) {=
        print("In deadline handler.")
        elapsed_logical_time = lf.time.logical_elapsed()
        elapsed_physicl_time = lf.time.physical_elapsed()
        print(f"Logical time = {elapsed_logical_time} and physical time = {elapsed_physicl_time}")
    =}

    reaction(end_execution) -> start_execution, out_port {=
        # Send task though the output port.

        # Schedule next execution if input data is ready
        self.current_task_index += 1

        if self.current_task_index >= len(self.task_queue):
            print(f"AGX: finish executing all scheduled tasks")
        else:
            task = self.task_queue[self.current_task_index]
            task_name = task.name
            if self.input_data[task_name] is True:
                # schedule
                print(f"Schedule task {task_name} at logical time {lf.time.logical_elapsed()}")
                start_execution.schedule(0)
    =}
}