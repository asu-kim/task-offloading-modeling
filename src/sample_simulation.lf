reactor OutputVisualizer(bandwidth_csv_path = "Bandwidth.csv") {
    input r1_output
    input r2_output
    input r3_output
    input r1_trace
    input r2_trace
    input r3_trace

    state received_traces = []
    state plotted = False
    state bandwidth = []
    state reactor_to_csv = []

    reaction(startup) {=
        self.received_traces = []
        self.bandwidth = []
        self.reactor_to_csv = {0: 0, 1: 1, 2: 2}
        # Load bandwidth matrix for computing comm durations
        import pandas as pd
        comm_df = pd.read_csv(project_path(self.bandwidth_csv_path), index_col=0)
        comm_df.columns = comm_df.columns.str.strip()
        comm_df.index = comm_df.index.str.strip()
        csv_names = list(comm_df.columns)
        n = len(csv_names)
        self.bandwidth = [[0] * n for _ in range(n)]
        for i in range(n):
            for j in range(n):
                v = comm_df.iloc[i, j]
                self.bandwidth[i][j] = int(v) if not pd.isna(v) else 0
    =}

    reaction(r1_trace, r2_trace, r3_trace) {=
        if r1_trace.is_present and not any(t[0] == 0 for t in self.received_traces):
            self.received_traces.append((0, r1_trace.value))
        if r2_trace.is_present and not any(t[0] == 1 for t in self.received_traces):
            self.received_traces.append((1, r2_trace.value))
        if r3_trace.is_present and not any(t[0] == 2 for t in self.received_traces):
            self.received_traces.append((2, r3_trace.value))

        if len(self.received_traces) != 3 or self.plotted:
            return

        self.plotted = True
        trace_by_device = {dev_id: trace for dev_id, trace in self.received_traces}
        all_events = (trace_by_device.get(0, []) + trace_by_device.get(1, []) + trace_by_device.get(2, []))

        comp_events = [e for e in all_events if e.get("type") == "comp"]
        comm_events = [e for e in all_events if e.get("type") == "comm_send"]

        # Always show all three devices (indices 0,1,2). HE may assign no work to one of them;
        # previously we only listed devices with comp events, which hid idle devices like Blackwell.
        device_index_to_name = {0: "Jetson", 1: "A6000", 2: "Blackwell"}
        for e in comp_events:
            device_index_to_name[e["device_index"]] = e["device_name"]
        # Desired visual order (top -> bottom): Jetson, A6000, Blackwell.
        desired_top_to_bottom = [0, 1, 2]
        display_bottom_to_top = list(reversed(desired_top_to_bottom))
        num_devices = len(display_bottom_to_top)

        device_index_to_comp_row = {}
        device_index_to_comm_row = {}
        row_labels = [""] * (2 * num_devices)
        for i, dev_idx in enumerate(display_bottom_to_top):
            comm_row = i * 2
            comp_row = i * 2 + 1
            device_index_to_comp_row[dev_idx] = comp_row
            device_index_to_comm_row[dev_idx] = comm_row
            name = device_index_to_name[dev_idx]
            row_labels[comp_row] = f"{name}_comp"
            row_labels[comm_row] = f"{name}_comm"

        tasks = sorted({e["task_name"] for e in comp_events})
        if not tasks:
            return
        cmap = plt.get_cmap("tab10")
        task_colors = {task: cmap(i % cmap.N) for i, task in enumerate(tasks)}

        def to_ms(sec):
            return float(sec) * 1000.0

        fig_height = max(4, num_devices * 1.5)
        fig, ax = plt.subplots(figsize=(12, fig_height))
        bar_height = 0.6
        xmax_ms = 100.0

        for e in comp_events:
            row = device_index_to_comp_row[e["device_index"]]
            start_ms = to_ms(e["start_time"])
            dur_ms = to_ms(e["end_time"] - e["start_time"])
            end_ms = to_ms(e["end_time"])
            task = e["task_name"]
            color = task_colors.get(task, "gray")
            deadline_ms = e.get("deadline_ms", -1)
            if deadline_ms is not None and int(deadline_ms) > 0:
                status = "OK" if end_ms <= float(deadline_ms) else "MISSED"
                xmax_ms = max(xmax_ms, end_ms + 50.0, float(deadline_ms) + 50.0)
            else:
                status = "OK" if e.get("deadline_met", True) else "MISSED"
                xmax_ms = max(xmax_ms, end_ms + 50.0)
            ax.broken_barh(
                [(start_ms, dur_ms)],
                (row - bar_height/2, bar_height),
                facecolors=color
            )
            ax.text(
                start_ms + dur_ms/2, row,
                f"{task} ({status})",
                ha="center", va="center",
                fontsize=8, color="white", clip_on=True
            )

        for e in comm_events:
            from_dev = e["from_device"]
            to_dev = e["to_device"]
            start_ms = to_ms(e["start_time"])
            output_size = e.get("output_size", 0)
            csv_from = self.reactor_to_csv.get(from_dev, from_dev)
            csv_to = self.reactor_to_csv.get(to_dev, to_dev)
            bw = self.bandwidth[csv_from][csv_to] if self.bandwidth else 0
            dur_ms = float(transfer_time_ms(output_size, bw)) if bw > 0 else 0.0
            task = e["task_name"]
            color = task_colors.get(task, "gray")
            xmax_ms = max(xmax_ms, start_ms + dur_ms + 50.0)

            # Draw communication on both sender and receiver comm lanes.
            comm_rows = [device_index_to_comm_row[from_dev], device_index_to_comm_row[to_dev]]
            for row in comm_rows:
                ax.broken_barh(
                    [(start_ms, dur_ms)],
                    (row - bar_height/2, bar_height),
                    facecolors=color,
                    alpha=0.7
                )
                ax.text(
                    start_ms + dur_ms/2, row,
                    f"{task} (comm)",
                    ha="center", va="center",
                    fontsize=8, color="white", clip_on=True
                )

        # Vertical deadline markers (ms), one line per distinct deadline
        drawn_deadlines = set()
        for e in comp_events:
            dm = e.get("deadline_ms", -1)
            if dm is None or int(dm) <= 0:
                continue
            dm_f = float(dm)
            if dm_f in drawn_deadlines:
                continue
            drawn_deadlines.add(dm_f)
            ax.axvline(dm_f, color="0.35", linestyle="--", linewidth=1.2, alpha=0.85, zorder=0)

        xmax_ms = max(xmax_ms, 100.0)
        xmax_ms = float(int(math.ceil(xmax_ms / 100.0)) * 100)
        ax.set_xlim(0.0, xmax_ms)

        tick_quantum_ms = 100.0
        max_tick_count = 10
        if xmax_ms <= tick_quantum_ms * (max_tick_count - 1):
            x_ticks = [float(v) for v in range(0, int(xmax_ms) + 1, int(tick_quantum_ms))]
        else:
            x_ticks = []
            for i in range(max_tick_count):
                raw_tick = (xmax_ms * i) / float(max_tick_count - 1)
                clipped_tick = math.floor(raw_tick / tick_quantum_ms) * tick_quantum_ms
                if len(x_ticks) == 0 or clipped_tick > x_ticks[-1]:
                    x_ticks.append(float(clipped_tick))
            max_clipped_tick = math.floor(xmax_ms / tick_quantum_ms) * tick_quantum_ms
            if len(x_ticks) > 0:
                x_ticks[-1] = float(max_clipped_tick)
        ax.set_xticks(x_ticks)
        ax.xaxis.set_major_formatter(
            mticker.FuncFormatter(lambda value, _: f"{int(math.floor(value / tick_quantum_ms) * tick_quantum_ms)}")
        )

        ax.set_yticks(range(len(row_labels)))
        ax.set_yticklabels(row_labels)
        ax.set_xlabel("Time (ms)")
        ax.set_title("Device Scheduling (from runtime trace)")
        ax.grid(axis="x", linestyle="--", alpha=0.4)
        handles = [
            Line2D([0], [0], color=task_colors[t], lw=8, label=t)
            for t in tasks
        ]
        handles.append(Line2D([0], [0], color="0.35", linestyle="--", lw=1.5, label="Deadline"))
        ax.legend(handles=handles, title="Task types")
        plt.tight_layout()
        out_path = project_path("schedule_trace.png")
        plt.savefig(out_path, dpi=150)
        plt.close(fig)
    =}
}

reactor NetworkFabric {
    // network packet format: [destination, payload size]
    input change

    input in_port0
    input in_port1
    input in_port2
    logical action out_port0_trigger
    logical action out_port1_trigger
    logical action out_port2_trigger
    output out_port0
    output out_port1
    output out_port2

    state num_devices = 3
    state bandwidth
    state devices
    state pending_packets  # Per-destination queues of (ready_time_ns, packet)
    state sender_available_ns  # Per-sender next-available logical time (ns)

    reaction(startup) {=
        bandwidth_csv_path = project_path("Bandwidth.csv")

        self.devices = [Device() for _ in range(self.num_devices)]
        self.bandwidth = [[0] * self.num_devices for _ in range(self.num_devices)]
        self.pending_packets = [[], [], []]
        self.sender_available_ns = [0, 0, 0]

        # Load bandwidths from CSV
        # Read with pandas and strip whitespace from column names
        comm_df = pd.read_csv(bandwidth_csv_path, index_col=0)
        # Strip whitespace from both column names and index names
        comm_df.columns = comm_df.columns.str.strip()
        comm_df.index = comm_df.index.str.strip()
        
        # Get device names from CSV columns
        csv_device_names = list(comm_df.columns)
        csv_index_names = list(comm_df.index)
        
        # Verify that CSV has the correct number of devices
        if len(csv_device_names) != self.num_devices:
            sys.exit(f"Error: Bandwidth CSV has {len(csv_device_names)} devices, but num_devices={self.num_devices}")
        if len(csv_index_names) != self.num_devices:
            sys.exit(f"Error: Bandwidth CSV index has {len(csv_index_names)} devices, but num_devices={self.num_devices}")
        
        # Verify that column names and index names match (they should for a symmetric bandwidth matrix)
        if csv_device_names != csv_index_names:
            sys.exit(f"Error: Bandwidth CSV column names and index names do not match. Columns: {csv_device_names}, Index: {csv_index_names}")
        
        # Assign device names from CSV columns (in order, preserves duplicates)
        for i, device in enumerate(self.devices):
            device.name = csv_device_names[i]
            device.index = i
        
        # Populate bandwidth matrix directly from CSV
        # Access by position using .values to avoid issues with duplicate column/index names
        # Since CSV rows are in the same order as devices, use device index directly as row index
        comm_values = comm_df.values  # Get numpy array
        for i, device in enumerate(self.devices):
            device_name = device.name
            # Verify the device name matches the CSV row (for validation)
            csv_row_name = comm_df.index[i]
            if csv_row_name != device_name:
                sys.exit(f"Error: Device name mismatch at index {i}. Expected {device_name}, found {csv_row_name} in CSV.")
            
            # Use device index directly as row index (CSV rows are in device order)
            row_idx = i
            
            for j, target_device in enumerate(self.devices):
                # Access by position using numpy array
                value = comm_values[row_idx, j]
                # Check if value is NaN (numpy.nan)
                if pd.isna(value) or (isinstance(value, float) and (value != value)):  # NaN check: value != value
                    sys.exit("Error: No NA is expected.")
                else:
                    self.bandwidth[i][j] = int(value)
        print("In Network Febric, bandwidth:")
        print(self.bandwidth)
    =}

    reaction(in_port0, in_port1, in_port2) -> out_port0_trigger, out_port1_trigger, out_port2_trigger{=
        incoming_packets = []
        if in_port0.is_present:
            incoming_packets.append((0, in_port0.value))
        if in_port1.is_present:
            incoming_packets.append((1, in_port1.value))
        if in_port2.is_present:
            incoming_packets.append((2, in_port2.value))

        if len(incoming_packets) == 0:
            return

        for source_port, packet in incoming_packets:
            if isinstance(packet, dict) and "destination_device" in packet:
                destination_device = packet["destination_device"]

                # Compute communication completion delay based on payload and bandwidth.
                payload_size = packet.get("input_size", packet.get("output_size", 0))
                bw = self.bandwidth[source_port][destination_device]
                transfer_delay_ms = transfer_time_ms(payload_size, bw) if bw > 0 else 0
                now_ns = int(lf.time.logical_elapsed())

                # Sequential sender-channel model:
                # a sender can start the next transfer only after its current one finishes.
                transfer_start_ns = max(now_ns, int(self.sender_available_ns[source_port]))
                ready_time_ns = transfer_start_ns + int(transfer_delay_ms) * 1000000
                self.sender_available_ns[source_port] = ready_time_ns

                schedule_wait_ms = int(math.ceil((ready_time_ns - now_ns) / 1000000.0))

                if destination_device == 0:
                    print(f"NetworkFabric: Routing packet from device {source_port} to device 0 (Jetson)")
                    self.pending_packets[0].append((ready_time_ns, packet))
                    self.pending_packets[0].sort(key=lambda x: x[0])
                    out_port0_trigger.schedule(MSEC(max(schedule_wait_ms, 0)))
                elif destination_device == 1:
                    print(f"NetworkFabric: Routing packet from device {source_port} to device 1 (A6000)")
                    self.pending_packets[1].append((ready_time_ns, packet))
                    self.pending_packets[1].sort(key=lambda x: x[0])
                    out_port1_trigger.schedule(MSEC(max(schedule_wait_ms, 0)))
                elif destination_device == 2:
                    print(f"NetworkFabric: Routing packet from device {source_port} to device 2 (Blackwell)")
                    self.pending_packets[2].append((ready_time_ns, packet))
                    self.pending_packets[2].sort(key=lambda x: x[0])
                    out_port2_trigger.schedule(MSEC(max(schedule_wait_ms, 0)))
                else:
                    print(f"NetworkFabric: Error - Invalid destination device {destination_device}")
            else:
                print(f"NetworkFabric: Error - Invalid packet format")
    =}

    reaction(out_port0_trigger) -> out_port0, out_port0_trigger {=
        if len(self.pending_packets[0]) == 0:
            return

        current_ns = int(lf.time.logical_elapsed())
        self.pending_packets[0].sort(key=lambda x: x[0])
        next_ready_ns, _ = self.pending_packets[0][0]
        if next_ready_ns > current_ns:
            wait_ms = int(math.ceil((next_ready_ns - current_ns) / 1000000.0))
            out_port0_trigger.schedule(MSEC(max(wait_ms, 1)))
            return

        _, packet = self.pending_packets[0].pop(0)
        out_port0.set(packet)
        if len(self.pending_packets[0]) > 0:
            next_wait_ms = int(math.ceil((self.pending_packets[0][0][0] - current_ns) / 1000000.0))
            out_port0_trigger.schedule(MSEC(max(next_wait_ms, 0)))
    =}
    reaction(out_port1_trigger) -> out_port1, out_port1_trigger {=
        if len(self.pending_packets[1]) == 0:
            return

        current_ns = int(lf.time.logical_elapsed())
        self.pending_packets[1].sort(key=lambda x: x[0])
        next_ready_ns, _ = self.pending_packets[1][0]
        if next_ready_ns > current_ns:
            wait_ms = int(math.ceil((next_ready_ns - current_ns) / 1000000.0))
            out_port1_trigger.schedule(MSEC(max(wait_ms, 1)))
            return

        _, packet = self.pending_packets[1].pop(0)
        out_port1.set(packet)
        if len(self.pending_packets[1]) > 0:
            next_wait_ms = int(math.ceil((self.pending_packets[1][0][0] - current_ns) / 1000000.0))
            out_port1_trigger.schedule(MSEC(max(next_wait_ms, 0)))
    =}
    reaction(out_port2_trigger) -> out_port2, out_port2_trigger {=
        if len(self.pending_packets[2]) == 0:
            return

        current_ns = int(lf.time.logical_elapsed())
        self.pending_packets[2].sort(key=lambda x: x[0])
        next_ready_ns, _ = self.pending_packets[2][0]
        if next_ready_ns > current_ns:
            wait_ms = int(math.ceil((next_ready_ns - current_ns) / 1000000.0))
            out_port2_trigger.schedule(MSEC(max(wait_ms, 1)))
            return

        _, packet = self.pending_packets[2].pop(0)
        out_port2.set(packet)
        if len(self.pending_packets[2]) > 0:
            next_wait_ms = int(math.ceil((self.pending_packets[2][0][0] - current_ns) / 1000000.0))
            out_port2_trigger.schedule(MSEC(max(next_wait_ms, 0)))
    =}
}

main reactor(fast_enable = True) {
    s = new HUScheduler(num_devices = 3, task_csv_path = "Tasks.csv", dependency_csv_path = "Dependencies.csv", bandwidth_csv_path = "Bandwidth.csv")
    r_1 = new ComputeDevice(device_index = 0, device_type_index = 0, device_name = "Jetson", bandwidth_csv_path = "Bandwidth.csv", fast_enable = fast_enable)
    r_2 = new ComputeDevice(device_index = 1, device_type_index = 1, device_name = "A6000", bandwidth_csv_path = "Bandwidth.csv", fast_enable = fast_enable)
    r_3 = new ComputeDevice(device_index = 2, device_type_index = 2, device_name = "Blackwell", bandwidth_csv_path = "Bandwidth.csv", fast_enable = fast_enable)
    // v = new Visulizer()
    // sr = new SchedulingResult()
    n = new NetworkFabric()
    t = new TaskSetSource()
    e = new EnvironmentUpdateDetector()
    o = new OutputVisualizer()

    t.tasks, e.change -> s.tasks, s.change
    e.change -> n.change

    // v.csv_path -> s.csv_path
    s.tasks_to_run -> r_1.tasks_to_run, r_2.tasks_to_run, r_3.tasks_to_run
    s.communication_map -> r_1.communication_map, r_2.communication_map, r_3.communication_map
    // s.tasks_to_run -> sr.tasks_to_run

    r_1.out_port -> n.in_port0 after 1 ms
    n.out_port0 -> r_1.in_port after 1 ms

    r_2.out_port -> n.in_port1 after 2 ms
    n.out_port1 -> r_2.in_port after 2 ms
    
    r_3.out_port -> n.in_port2 after 3 ms
    n.out_port2 -> r_3.in_port after 3 ms

    r_1.final_output, r_2.final_output, r_3.final_output -> o.r1_output, o.r2_output, o.r3_output
    r_1.trace_output -> o.r1_trace
    r_2.trace_output -> o.r2_trace
    r_3.trace_output -> o.r3_trace

    // r_1.send_a6000 -> r_2.recv_agx after 5 msec
    // r_1.send_blackwell -> r_3.recv_agx after 2 msec
    // r_2.send_blackwell -> r_3.recv_a6000 after 3 msec
    // r_2.send_agx -> r_1.recv_a6000 after 5 msec
    // r_3.send_a6000 -> r_2.recv_blackwell after 3 msec
    // r_3.send_agx -> r_1.recv_blackwell after 2 msec

    //check_deadline
    // LET by physical time or WCET
}
