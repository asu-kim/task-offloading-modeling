    reaction(out_port0_trigger) -> out_port0, out_port0_trigger {=
        if len(self.pending_packets[0]) == 0:
            return
        current_ns = int(lf.time.logical_elapsed())
        self.pending_packets[0].sort(key=lambda x: x[0])
        next_ready_ns, _ = self.pending_packets[0][0]
        if next_ready_ns > current_ns:
            out_port0_trigger.schedule(MSEC(max(int(math.ceil((next_ready_ns - current_ns) / 1000000.0)), 1)))
            return
        _, packet = self.pending_packets[0].pop(0)
        out_port0.set(packet)
        if len(self.pending_packets[0]) > 0:
            out_port0_trigger.schedule(MSEC(max(int(math.ceil((self.pending_packets[0][0][0] - current_ns) / 1000000.0)), 0)))
