main reactor(fast_enable = True) {
    s = new HUScheduler(num_devices = 66, task_csv_path = "data/sample_simulation_64Jetson/Tasks.csv", dependency_csv_path = "data/sample_simulation_64Jetson/Dependencies.csv", bandwidth_csv_path = "data/sample_simulation_64Jetson/Bandwidth.csv")
    r_1 = new ComputeDevice(device_index = 0, device_type_index = 0, device_name = "Jetson_1", bandwidth_csv_path = "data/sample_simulation_64Jetson/Bandwidth.csv", fast_enable = fast_enable)
