main reactor(fast_enable = True) {
    s = new HEFTScheduler(num_devices = 18, task_csv_path = "data/sample_simulation_16Jetson/Tasks.csv", dependency_csv_path = "data/sample_simulation_16Jetson/Dependencies.csv", bandwidth_csv_path = "data/sample_simulation_16Jetson/Bandwidth.csv")
    r_1 = new ComputeDevice(device_index = 0, device_type_index = 0, device_name = "Jetson_1", bandwidth_csv_path = "data/sample_simulation_16Jetson/Bandwidth.csv", fast_enable = fast_enable)
    r_2 = new ComputeDevice(device_index = 1, device_type_index = 0, device_name = "Jetson_2", bandwidth_csv_path = "data/sample_simulation_16Jetson/Bandwidth.csv", fast_enable = fast_enable)
    r_3 = new ComputeDevice(device_index = 2, device_type_index = 0, device_name = "Jetson_3", bandwidth_csv_path = "data/sample_simulation_16Jetson/Bandwidth.csv", fast_enable = fast_enable)
    r_4 = new ComputeDevice(device_index = 3, device_type_index = 0, device_name = "Jetson_4", bandwidth_csv_path = "data/sample_simulation_16Jetson/Bandwidth.csv", fast_enable = fast_enable)
    r_5 = new ComputeDevice(device_index = 4, device_type_index = 0, device_name = "Jetson_5", bandwidth_csv_path = "data/sample_simulation_16Jetson/Bandwidth.csv", fast_enable = fast_enable)
    r_6 = new ComputeDevice(device_index = 5, device_type_index = 0, device_name = "Jetson_6", bandwidth_csv_path = "data/sample_simulation_16Jetson/Bandwidth.csv", fast_enable = fast_enable)
    r_7 = new ComputeDevice(device_index = 6, device_type_index = 0, device_name = "Jetson_7", bandwidth_csv_path = "data/sample_simulation_16Jetson/Bandwidth.csv", fast_enable = fast_enable)
    r_8 = new ComputeDevice(device_index = 7, device_type_index = 0, device_name = "Jetson_8", bandwidth_csv_path = "data/sample_simulation_16Jetson/Bandwidth.csv", fast_enable = fast_enable)
    r_9 = new ComputeDevice(device_index = 8, device_type_index = 0, device_name = "Jetson_9", bandwidth_csv_path = "data/sample_simulation_16Jetson/Bandwidth.csv", fast_enable = fast_enable)
    r_10 = new ComputeDevice(device_index = 9, device_type_index = 0, device_name = "Jetson_10", bandwidth_csv_path = "data/sample_simulation_16Jetson/Bandwidth.csv", fast_enable = fast_enable)
    r_11 = new ComputeDevice(device_index = 10, device_type_index = 0, device_name = "Jetson_11", bandwidth_csv_path = "data/sample_simulation_16Jetson/Bandwidth.csv", fast_enable = fast_enable)
    r_12 = new ComputeDevice(device_index = 11, device_type_index = 0, device_name = "Jetson_12", bandwidth_csv_path = "data/sample_simulation_16Jetson/Bandwidth.csv", fast_enable = fast_enable)
    r_13 = new ComputeDevice(device_index = 12, device_type_index = 0, device_name = "Jetson_13", bandwidth_csv_path = "data/sample_simulation_16Jetson/Bandwidth.csv", fast_enable = fast_enable)
    r_14 = new ComputeDevice(device_index = 13, device_type_index = 0, device_name = "Jetson_14", bandwidth_csv_path = "data/sample_simulation_16Jetson/Bandwidth.csv", fast_enable = fast_enable)
    r_15 = new ComputeDevice(device_index = 14, device_type_index = 0, device_name = "Jetson_15", bandwidth_csv_path = "data/sample_simulation_16Jetson/Bandwidth.csv", fast_enable = fast_enable)
    r_16 = new ComputeDevice(device_index = 15, device_type_index = 0, device_name = "Jetson_16", bandwidth_csv_path = "data/sample_simulation_16Jetson/Bandwidth.csv", fast_enable = fast_enable)
    r_17 = new ComputeDevice(device_index = 16, device_type_index = 1, device_name = "A6000", bandwidth_csv_path = "data/sample_simulation_16Jetson/Bandwidth.csv", fast_enable = fast_enable)
    r_18 = new ComputeDevice(device_index = 17, device_type_index = 2, device_name = "Blackwell", bandwidth_csv_path = "data/sample_simulation_16Jetson/Bandwidth.csv", fast_enable = fast_enable)
    n = new NetworkFabric16Jetson()
    t = new TaskSetSource()
    e = new EnvironmentUpdateDetector()
    o = new OutputVisualizer16Jetson()

    t.tasks, e.change -> s.tasks, s.change
    e.change -> n.change

    s.tasks_to_run -> r_1.tasks_to_run, r_2.tasks_to_run, r_3.tasks_to_run, r_4.tasks_to_run, r_5.tasks_to_run, r_6.tasks_to_run, r_7.tasks_to_run, r_8.tasks_to_run, r_9.tasks_to_run, r_10.tasks_to_run, r_11.tasks_to_run, r_12.tasks_to_run, r_13.tasks_to_run, r_14.tasks_to_run, r_15.tasks_to_run, r_16.tasks_to_run, r_17.tasks_to_run, r_18.tasks_to_run
    s.communication_map -> r_1.communication_map, r_2.communication_map, r_3.communication_map, r_4.communication_map, r_5.communication_map, r_6.communication_map, r_7.communication_map, r_8.communication_map, r_9.communication_map, r_10.communication_map, r_11.communication_map, r_12.communication_map, r_13.communication_map, r_14.communication_map, r_15.communication_map, r_16.communication_map, r_17.communication_map, r_18.communication_map

    r_1.out_port -> n.in_port0 after 1 ms
    r_2.out_port -> n.in_port1 after 1 ms
    r_3.out_port -> n.in_port2 after 1 ms
    r_4.out_port -> n.in_port3 after 1 ms
    r_5.out_port -> n.in_port4 after 1 ms
    r_6.out_port -> n.in_port5 after 1 ms
    r_7.out_port -> n.in_port6 after 1 ms
    r_8.out_port -> n.in_port7 after 1 ms
    r_9.out_port -> n.in_port8 after 1 ms
    r_10.out_port -> n.in_port9 after 1 ms
    r_11.out_port -> n.in_port10 after 1 ms
    r_12.out_port -> n.in_port11 after 1 ms
    r_13.out_port -> n.in_port12 after 1 ms
    r_14.out_port -> n.in_port13 after 1 ms
    r_15.out_port -> n.in_port14 after 1 ms
    r_16.out_port -> n.in_port15 after 1 ms
    r_17.out_port -> n.in_port16 after 1 ms
    r_18.out_port -> n.in_port17 after 1 ms

    n.out_port0 -> r_1.in_port after 1 ms
    n.out_port1 -> r_2.in_port after 1 ms
    n.out_port2 -> r_3.in_port after 1 ms
    n.out_port3 -> r_4.in_port after 1 ms
    n.out_port4 -> r_5.in_port after 1 ms
    n.out_port5 -> r_6.in_port after 1 ms
    n.out_port6 -> r_7.in_port after 1 ms
    n.out_port7 -> r_8.in_port after 1 ms
    n.out_port8 -> r_9.in_port after 1 ms
    n.out_port9 -> r_10.in_port after 1 ms
    n.out_port10 -> r_11.in_port after 1 ms
    n.out_port11 -> r_12.in_port after 1 ms
    n.out_port12 -> r_13.in_port after 1 ms
    n.out_port13 -> r_14.in_port after 1 ms
    n.out_port14 -> r_15.in_port after 1 ms
    n.out_port15 -> r_16.in_port after 1 ms
    n.out_port16 -> r_17.in_port after 1 ms
    n.out_port17 -> r_18.in_port after 1 ms

    r_1.final_output, r_2.final_output, r_3.final_output, r_4.final_output, r_5.final_output, r_6.final_output, r_7.final_output, r_8.final_output, r_9.final_output, r_10.final_output, r_11.final_output, r_12.final_output, r_13.final_output, r_14.final_output, r_15.final_output, r_16.final_output, r_17.final_output, r_18.final_output -> o.d0_output, o.d1_output, o.d2_output, o.d3_output, o.d4_output, o.d5_output, o.d6_output, o.d7_output, o.d8_output, o.d9_output, o.d10_output, o.d11_output, o.d12_output, o.d13_output, o.d14_output, o.d15_output, o.d16_output, o.d17_output
    r_1.trace_output -> o.d0_trace
    r_2.trace_output -> o.d1_trace
    r_3.trace_output -> o.d2_trace
    r_4.trace_output -> o.d3_trace
    r_5.trace_output -> o.d4_trace
    r_6.trace_output -> o.d5_trace
    r_7.trace_output -> o.d6_trace
    r_8.trace_output -> o.d7_trace
    r_9.trace_output -> o.d8_trace
    r_10.trace_output -> o.d9_trace
    r_11.trace_output -> o.d10_trace
    r_12.trace_output -> o.d11_trace
    r_13.trace_output -> o.d12_trace
    r_14.trace_output -> o.d13_trace
    r_15.trace_output -> o.d14_trace
    r_16.trace_output -> o.d15_trace
    r_17.trace_output -> o.d16_trace
    r_18.trace_output -> o.d17_trace
}
