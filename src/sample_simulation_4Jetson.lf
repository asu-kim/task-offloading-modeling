target Python {
    fast: true
}

import ComputeDevice from "../lib/simulation/ComputeDevice.lf"

preamble {=
    import sys
    import random
    import math
    import logging
    from dataclasses import dataclass, field
    from pathlib import Path
    from typing import Deque, List, Dict, Tuple, Set
    import pandas as pd
    from collections import deque
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    import matplotlib.ticker as mticker
    from matplotlib.lines import Line2D
    import time

    logger = logging.getLogger(__name__)

    PROJECT_ROOT = Path(__file__).resolve().parents[2]

    def project_path(*parts):
        return str(PROJECT_ROOT.joinpath(*parts))

    def scenario_path(filename: str) -> str:
        return project_path("data", "sample_simulation_4Jetson", filename)

    def transfer_time_ms(data_size_mb: float, bandwidth_mb_per_sec: int) -> int:
        if data_size_mb == 0 or bandwidth_mb_per_sec == 0:
            return 0
        return int(math.ceil(float(data_size_mb) / float(bandwidth_mb_per_sec)))

    def device_name_to_type_index(device_name: str) -> int | None:
        if device_name.startswith("Jetson"):
            return 0
        if device_name.startswith("A6000"):
            return 1
        if device_name.startswith("Blackwell"):
            return 2
        return None

    @dataclass
    class Task:
        name: str = ""
        index: int = 0
        deadline: int = -1
        execution_times: List[int] = field(default_factory=list)
        child_task_indexes: List[int] = field(default_factory=list, repr=False)
        parent_task_indexes: List[int] = field(default_factory=list, repr=False)
        input_size: int = 0
        output_size: int = 0
        source_device_index: int = 0
        priority: float = 0
        ready_time: int = -1
        current_device: str = ""
        communication_start_time: int = 0
        communication_end_time: int = 0
        computation_start_time: int = 0
        computation_end_time: int = 0

    @dataclass
    class Device:
        name: str = ""
        index: int = 0
        task_queue: Deque[Task] = field(default_factory=deque)
        comm_channel_available: int = 0
        comm_queue: list[Tuple[str, int, int]] = field(default_factory=list)

    @dataclass
    class System:
        task_csv_path: str
        dependency_csv_path: str
        bandwidth_csv_path: str
        period: int = -1
        num_devices: int = 6
        tasks: list[Task] = field(default_factory=list)
        edges: List[List[int]] = field(init=False)
        devices: list[Device] = field(init=False)
        bandwidth: list[list[int]] = field(init=False)

        def __post_init__(self):
            self.devices = [Device() for _ in range(self.num_devices)]
            self.bandwidth = [[0] * self.num_devices for _ in range(self.num_devices)]

            comm_df = pd.read_csv(self.bandwidth_csv_path, index_col=0)
            comm_df.columns = comm_df.columns.str.strip()
            comm_df.index = comm_df.index.str.strip()
            csv_device_names = list(comm_df.columns)
            csv_index_names = list(comm_df.index)

            if len(csv_device_names) != self.num_devices:
                sys.exit(f"Error: Bandwidth CSV has {len(csv_device_names)} devices, but num_devices={self.num_devices}")
            if len(csv_index_names) != self.num_devices:
                sys.exit(f"Error: Bandwidth CSV index has {len(csv_index_names)} devices, but num_devices={self.num_devices}")
            if csv_device_names != csv_index_names:
                sys.exit(f"Error: Bandwidth CSV column names and index names do not match. Columns: {csv_device_names}, Index: {csv_index_names}")

            for i, device in enumerate(self.devices):
                device.name = csv_device_names[i]
                device.index = i

            comm_values = comm_df.values
            for i, device in enumerate(self.devices):
                if comm_df.index[i] != device.name:
                    sys.exit(f"Error: Device name mismatch at index {i}.")
                for j in range(self.num_devices):
                    value = comm_values[i, j]
                    if pd.isna(value) or (isinstance(value, float) and (value != value)):
                        sys.exit("Error: No NA is expected.")
                    self.bandwidth[i][j] = int(value)

            df = pd.read_csv(self.task_csv_path)
            index = 0
            for _, row in df.iterrows():
                name = str(row.iloc[0]).strip()
                if not name or name.lower() == "nan":
                    continue
                task = Task(
                    name=name,
                    index=index,
                    deadline=int(float(row.iloc[1])),
                    execution_times=[
                        int(float(row.iloc[2])),
                        int(float(row.iloc[3])),
                        int(float(row.iloc[4])),
                    ],
                    input_size=int(row.iloc[5]),
                    output_size=int(row.iloc[6]),
                    source_device_index=int(float(row.iloc[7])) if len(row) > 7 else 0,
                )
                self.tasks.append(task)
                index += 1

            num_tasks = len(self.tasks)
            self.edges = [[0 for _ in range(num_tasks)] for _ in range(num_tasks)]
            prob_df = pd.read_csv(self.dependency_csv_path, header=0, index_col=None)
            for i in range(num_tasks):
                for j in range(num_tasks):
                    dependency = prob_df.iloc[i, j + 1]
                    if int(dependency) not in (0, 1):
                        sys.exit("Error: Dependency must be 0 or 1.")
                    self.edges[i][j] = int(dependency)

            for i in range(num_tasks):
                for j in range(num_tasks):
                    if self.edges[i][j] == 1:
                        if i not in self.tasks[j].parent_task_indexes:
                            self.tasks[j].parent_task_indexes.append(i)
                        if j not in self.tasks[i].child_task_indexes:
                            self.tasks[i].child_task_indexes.append(j)

            jetson_device_indices = [i for i, device in enumerate(self.devices) if device.name.startswith("Jetson")]
            if len(jetson_device_indices) == 0:
                sys.exit("Error: No Jetson device found in system")

            source_tasks = [task for task in self.tasks if len(task.parent_task_indexes) == 0]
            for task in source_tasks:
                prefix = task.name.split("_", 1)[0]
                if prefix.startswith("R") and prefix[1:].isdigit():
                    robot_index = int(prefix[1:]) - 1
                    if robot_index in jetson_device_indices:
                        task.source_device_index = robot_index
                        continue
                task.source_device_index = random.choice(jetson_device_indices)

            if len(self.tasks) > 0:
                max_deadline = max((task.deadline for task in self.tasks if task.deadline > 0), default=-1)
                if max_deadline > 0:
                    self.period = max_deadline
                elif self.period == -1:
                    sys.exit("No deadline is found")

    def compute_finish_time(task: Task, device: Device, system: System, current_time: int) -> int:
        comm_end_time = current_time

        if len(task.parent_task_indexes) > 0:
            parent_task = system.tasks[task.parent_task_indexes[0]]
            parent_device = parent_task.current_device
            if parent_device is None:
                return sys.maxsize
            if parent_device == device:
                comm_end_time = current_time
            else:
                source_comm_available = max(parent_device.comm_channel_available, parent_task.computation_end_time)
                target_comm_available = device.comm_channel_available
                parent_completion_time = parent_task.computation_end_time
                transfer_start_time = max(source_comm_available, target_comm_available, parent_completion_time, current_time)
                bandwidth = system.bandwidth[parent_device.index][device.index]
                transfer_time = transfer_time_ms(task.input_size, bandwidth) if bandwidth > 0 else 0
                comm_end_time = transfer_start_time + transfer_time
        else:
            source_device = system.devices[task.source_device_index]
            if source_device == device:
                comm_end_time = current_time
            else:
                source_comm_available = source_device.comm_channel_available
                target_comm_available = device.comm_channel_available
                transfer_start_time = max(source_comm_available, target_comm_available, current_time)
                bandwidth = system.bandwidth[source_device.index][device.index]
                if task.input_size != 0 and bandwidth == 0:
                    return sys.maxsize
                transfer_time = transfer_time_ms(task.input_size, bandwidth) if bandwidth > 0 else 0
                comm_end_time = transfer_start_time + transfer_time

        if len(device.task_queue) > 0:
            last_task_completion_time = device.task_queue[0].computation_end_time
        else:
            last_task_completion_time = current_time

        computation_start_time = max(last_task_completion_time, comm_end_time)
        device_type_index = device_name_to_type_index(device.name)
        if device_type_index is None:
            logger.error(f"Unknown device name: {device.name}")
            return sys.maxsize
        return computation_start_time + task.execution_times[device_type_index]

    def compute_communication_cost(parent_task: Task, child_task: Task, system: System) -> float:
        data_length = child_task.input_size
        if data_length == 0:
            return 0
        total_cost = 0.0
        for i in range(system.num_devices):
            for j in range(system.num_devices):
                bandwidth = system.bandwidth[i][j]
                if bandwidth > 0:
                    total_cost += data_length / bandwidth
        return total_cost / (system.num_devices * system.num_devices)

    def compute_upward_rank(task: Task, system: System, rank_cache: dict) -> float:
        if task.index in rank_cache:
            return rank_cache[task.index]
        w_i = sum(task.execution_times) / len(task.execution_times) if task.execution_times else 0
        if len(task.child_task_indexes) == 0:
            rank_cache[task.index] = w_i
            return w_i
        max_child_rank = 0
        for child_index in task.child_task_indexes:
            child_task = system.tasks[child_index]
            child_rank = compute_upward_rank(child_task, system, rank_cache)
            comm_cost = compute_communication_cost(task, child_task, system)
            max_child_rank = max(max_child_rank, comm_cost + child_rank)
        rank_u = w_i + max_child_rank
        rank_cache[task.index] = rank_u
        return rank_u

    def heft_scheduler(system: System, event_q: Deque[Task], current_time: int = 0):
        ready_tasks = [task for task in event_q if task.ready_time != -1 and task.ready_time <= current_time]
        rank_cache = {}
        for task in ready_tasks:
            task.priority = compute_upward_rank(task, system, rank_cache)
        mappings = []
        if len(ready_tasks) == 0:
            return mappings
        sorted_tasks = sorted(ready_tasks, key=lambda t: (-t.priority, t.deadline if t.deadline else sys.maxsize))
        assigned_device_indices = set()
        for task in sorted_tasks:
            best_device = None
            best_finish_time = sys.maxsize
            for device in system.devices:
                if device.index in assigned_device_indices:
                    continue
                finish_time = compute_finish_time(task, device, system, current_time)
                if finish_time < best_finish_time:
                    best_finish_time = finish_time
                    best_device = device
            if best_device is not None:
                mappings.append([task, best_device])
                assigned_device_indices.add(best_device.index)
                try:
                    event_q.remove(task)
                except ValueError:
                    pass
        return mappings

    def compute_level(task: Task, system: System) -> int:
        if len(task.child_task_indexes) == 0:
            return 0
        max_child_level = 0
        for child_index in task.child_task_indexes:
            child_task = system.tasks[child_index]
            max_child_level = max(max_child_level, compute_level(child_task, system))
        return 1 + max_child_level

    def hu_scheduler(system: System, event_q: Deque[Task], current_time: int = 0):
        ready_tasks = [task for task in event_q if task.ready_time != -1 and task.ready_time <= current_time]
        for task in ready_tasks:
            task.priority = compute_level(task, system)
        mappings = []
        if len(ready_tasks) == 0:
            return mappings
        sorted_tasks = sorted(ready_tasks, key=lambda t: (-t.priority, t.deadline if t.deadline else sys.maxsize))
        assigned_device_indices = set()
        for task in sorted_tasks:
            best_device = None
            best_finish_time = sys.maxsize
            for device in system.devices:
                if device.index in assigned_device_indices:
                    continue
                finish_time = compute_finish_time(task, device, system, current_time)
                if finish_time < best_finish_time:
                    best_finish_time = finish_time
                    best_device = device
            if best_device is not None:
                mappings.append([task, best_device])
                assigned_device_indices.add(best_device.index)
                try:
                    event_q.remove(task)
                except ValueError:
                    pass
        return mappings

    current_time = -1
    global_deadline = -1
    event_q: Deque[Task] = deque()
    job_assignments: List[Dict] = []
    scheduler_mode = "HU"
    scheduler = hu_scheduler if scheduler_mode == "HU" else heft_scheduler
    completed_parents: Dict[int, Set[int]] = {}

    def reset_simulation_state(system: System):
        global current_time, event_q, job_assignments, completed_parents
        current_time = -1
        event_q.clear()
        job_assignments.clear()
        completed_parents.clear()
        for task in system.tasks:
            task.ready_time = -1
            task.current_device = None
            task.communication_start_time = 0
            task.communication_end_time = 0
            task.computation_start_time = 0
            task.computation_end_time = 0
            task.priority = 0
        for device in system.devices:
            device.task_queue.clear()
            device.comm_channel_available = 0
            device.comm_queue.clear()

    def init(system: System):
        for task in system.tasks:
            if len(task.parent_task_indexes) == 0:
                task.ready_time = 0
            if task.deadline == -1:
                task.deadline = global_deadline
            event_q.append(task)

    def enqueue(system: System, completed_tasks: list[Task]):
        global completed_parents
        for task in completed_tasks:
            if task is None:
                sys.exit("Error: completed task is None")
            for child_index in task.child_task_indexes:
                if child_index not in completed_parents:
                    completed_parents[child_index] = set()
                completed_parents[child_index].add(task.index)
                child_task = system.tasks[child_index]
                if len(completed_parents[child_index]) == len(child_task.parent_task_indexes):
                    max_parent_completion = max(system.tasks[parent_index].computation_end_time for parent_index in child_task.parent_task_indexes)
                    child_task.ready_time = max_parent_completion

    def dispatch_jobs(system: System, mappings):
        global job_assignments
        for task, device in mappings:
            if len(task.parent_task_indexes) > 0:
                parent_task = system.tasks[task.parent_task_indexes[0]]
                if parent_task.current_device == device:
                    task.communication_start_time = current_time
                    task.communication_end_time = current_time
                else:
                    source_device = parent_task.current_device
                    source_comm_available = max(source_device.comm_channel_available, parent_task.computation_end_time)
                    target_comm_available = device.comm_channel_available
                    task.communication_start_time = max(source_comm_available, target_comm_available, parent_task.computation_end_time, current_time)
                    bandwidth = system.bandwidth[source_device.index][device.index]
                    transfer_time = transfer_time_ms(task.input_size, bandwidth) if bandwidth > 0 else 0
                    task.communication_end_time = task.communication_start_time + transfer_time
                    source_device.comm_channel_available = task.communication_end_time
                    device.comm_channel_available = task.communication_end_time
                    source_device.comm_queue.insert(0, [device.name, task.communication_start_time, task.communication_end_time])
            else:
                source_device = system.devices[task.source_device_index]
                if source_device == device:
                    task.communication_start_time = current_time
                    task.communication_end_time = current_time
                else:
                    source_comm_available = source_device.comm_channel_available
                    target_comm_available = device.comm_channel_available
                    task.communication_start_time = max(source_comm_available, target_comm_available, current_time)
                    bandwidth = system.bandwidth[source_device.index][device.index]
                    transfer_time = transfer_time_ms(task.input_size, bandwidth) if bandwidth > 0 else 0
                    task.communication_end_time = task.communication_start_time + transfer_time
                    source_device.comm_channel_available = task.communication_end_time
                    device.comm_channel_available = task.communication_end_time
                    source_device.comm_queue.insert(0, [device.name, task.communication_start_time, task.communication_end_time])

            if len(device.task_queue) == 0:
                task.computation_start_time = max(task.communication_end_time, current_time)
            else:
                task.computation_start_time = max(device.task_queue[0].computation_end_time, task.communication_end_time)
            task.computation_end_time = task.computation_start_time + task.execution_times[device_name_to_type_index(device.name)]
            task.current_device = device
            device.task_queue.insert(0, task)
            job_assignments.append({"job": task, "device": device})

    def main_loop(system: System, reset_state: bool = True):
        global current_time
        if reset_state:
            reset_simulation_state(system)
        init(system)

        while True:
            if len(event_q) == 0:
                return job_assignments.copy()

            completion_candidates = [task.computation_end_time for device in system.devices for task in device.task_queue if task.computation_end_time > current_time]
            next_ready_candidates = [task.ready_time for task in event_q if task.ready_time > current_time]
            next_times = completion_candidates + next_ready_candidates
            if current_time == -1:
                current_time = 0
            elif len(next_times) == 0:
                return job_assignments.copy()
            else:
                current_time = min(next_times)

            completed_tasks = []
            for device in system.devices:
                while len(device.task_queue) > 0 and device.task_queue[-1].computation_end_time == current_time:
                    completed_tasks.append(device.task_queue.pop())

            if len(completed_tasks) > 0:
                enqueue(system, completed_tasks)

            mappings = scheduler(system=system, event_q=event_q, current_time=current_time)
            dispatch_jobs(system, mappings=mappings)
    =}

reactor Scheduler4Jetson {
    input change
    input tasks
    output[6] tasks_to_run
    output[6] communication_map

    reaction(startup, change, tasks) -> tasks_to_run, communication_map {=
        system = System(
            task_csv_path=scenario_path("Tasks.csv"),
            dependency_csv_path=scenario_path("Dependencies.csv"),
            bandwidth_csv_path=scenario_path("Bandwidth.csv"),
            num_devices=6
        )

        global global_deadline
        global_deadline = system.period
        job_assignments = main_loop(system, reset_state=True)

        device_task = [[] for _ in range(system.num_devices)]
        task_to_device = {}
        for assignment in job_assignments:
            device_index = assignment["device"].index
            task_index = assignment["job"].index
            task = assignment["job"]
            device_task[device_index].append(task)
            task_to_device[task_index] = device_index

        device_comm_map = [{} for _ in range(system.num_devices)]
        for assignment in job_assignments:
            task = assignment["job"]
            task_index = task.index
            mapped_device_index = task_to_device[task_index]

            if len(task.parent_task_indexes) == 0:
                source_device_index = task.source_device_index
                if source_device_index != mapped_device_index:
                    if task_index not in device_comm_map[source_device_index]:
                        device_comm_map[source_device_index][task_index] = {}
                    device_comm_map[source_device_index][task_index]["source_input"] = {
                        "destination_device": mapped_device_index,
                        "child_task": task,
                        "input_size": task.input_size,
                        "is_source_input": True
                    }

            for child_index in task.child_task_indexes:
                if child_index in task_to_device:
                    destination_device_index = task_to_device[child_index]
                    child_task = system.tasks[child_index]
                    if destination_device_index != mapped_device_index:
                        if task_index not in device_comm_map[mapped_device_index]:
                            device_comm_map[mapped_device_index][task_index] = {}
                        device_comm_map[mapped_device_index][task_index][child_index] = {
                            "destination_device": destination_device_index,
                            "child_task": child_task,
                            "output_size": task.output_size,
                            "is_source_input": False
                        }

        tasks_to_run[0].set(device_task[0])
        tasks_to_run[1].set(device_task[1])
        tasks_to_run[2].set(device_task[2])
        tasks_to_run[3].set(device_task[3])
        tasks_to_run[4].set(device_task[4])
        tasks_to_run[5].set(device_task[5])

        communication_map[0].set(device_comm_map[0])
        communication_map[1].set(device_comm_map[1])
        communication_map[2].set(device_comm_map[2])
        communication_map[3].set(device_comm_map[3])
        communication_map[4].set(device_comm_map[4])
        communication_map[5].set(device_comm_map[5])
    =}
}

reactor EnvironmentUpdateDetector {
    output change
    reaction(startup) -> change {=
    =}
}

reactor TaskSetSource {
    output tasks
    reaction(startup) -> tasks {=
    =}
}

reactor OutputVisualizer4Jetson {
    input d0_output
    input d1_output
    input d2_output
    input d3_output
    input d4_output
    input d5_output
    input d0_trace
    input d1_trace
    input d2_trace
    input d3_trace
    input d4_trace
    input d5_trace

    state received_traces = []
    state plotted = False
    state bandwidth = []

    reaction(startup) {=
        self.received_traces = []
        self.bandwidth = []
        comm_df = pd.read_csv(scenario_path("Bandwidth.csv"), index_col=0)
        comm_df.columns = comm_df.columns.str.strip()
        comm_df.index = comm_df.index.str.strip()
        n = len(comm_df.columns)
        self.bandwidth = [[0] * n for _ in range(n)]
        for i in range(n):
            for j in range(n):
                value = comm_df.iloc[i, j]
                self.bandwidth[i][j] = int(value) if not pd.isna(value) else 0
    =}

    reaction(d0_trace, d1_trace, d2_trace, d3_trace, d4_trace, d5_trace) {=
        trace_inputs = [
            (0, d0_trace),
            (1, d1_trace),
            (2, d2_trace),
            (3, d3_trace),
            (4, d4_trace),
            (5, d5_trace),
        ]
        for device_index, trace_input in trace_inputs:
            if trace_input.is_present and not any(t[0] == device_index for t in self.received_traces):
                self.received_traces.append((device_index, trace_input.value))

        if len(self.received_traces) != 6 or self.plotted:
            return

        self.plotted = True
        trace_by_device = {dev_id: trace for dev_id, trace in self.received_traces}
        all_events = []
        for device_index in range(6):
            all_events.extend(trace_by_device.get(device_index, []))

        comp_events = [e for e in all_events if e.get("type") == "comp"]
        comm_events = [e for e in all_events if e.get("type") == "comm_send"]
        device_index_to_name = {
            0: "Jetson_1",
            1: "Jetson_2",
            2: "Jetson_3",
            3: "Jetson_4",
            4: "A6000",
            5: "Blackwell",
        }
        for event in comp_events:
            device_index_to_name[event["device_index"]] = event["device_name"]

        desired_top_to_bottom = [0, 1, 2, 3, 4, 5]
        display_bottom_to_top = list(reversed(desired_top_to_bottom))
        num_devices = len(display_bottom_to_top)
        device_index_to_comp_row = {}
        device_index_to_comm_row = {}
        row_labels = [""] * (2 * num_devices)
        for i, dev_idx in enumerate(display_bottom_to_top):
            comm_row = i * 2
            comp_row = i * 2 + 1
            device_index_to_comp_row[dev_idx] = comp_row
            device_index_to_comm_row[dev_idx] = comm_row
            name = device_index_to_name[dev_idx]
            row_labels[comp_row] = f"{name}_comp"
            row_labels[comm_row] = f"{name}_comm"

        tasks = sorted({e["task_name"] for e in comp_events})
        if not tasks:
            return
        cmap = plt.get_cmap("tab20")
        task_colors = {task: cmap(i % cmap.N) for i, task in enumerate(tasks)}

        def to_ms(sec):
            return float(sec) * 1000.0

        fig, ax = plt.subplots(figsize=(14, max(6, num_devices * 1.5)))
        bar_height = 0.6
        xmax_ms = 100.0

        for event in comp_events:
            row = device_index_to_comp_row[event["device_index"]]
            start_ms = to_ms(event["start_time"])
            dur_ms = to_ms(event["end_time"] - event["start_time"])
            end_ms = to_ms(event["end_time"])
            task = event["task_name"]
            color = task_colors.get(task, "gray")
            deadline_ms = event.get("deadline_ms", -1)
            xmax_ms = max(xmax_ms, end_ms + 50.0, float(deadline_ms) + 50.0 if deadline_ms and deadline_ms > 0 else end_ms + 50.0)
            status = "OK" if deadline_ms <= 0 or end_ms <= float(deadline_ms) else "MISSED"
            ax.broken_barh([(start_ms, dur_ms)], (row - bar_height / 2, bar_height), facecolors=color)
            ax.text(start_ms + dur_ms / 2, row, f"{task} ({status})", ha="center", va="center", fontsize=7, color="white", clip_on=True)

        for event in comm_events:
            from_dev = event["from_device"]
            to_dev = event["to_device"]
            start_ms = to_ms(event["start_time"])
            output_size = event.get("output_size", 0)
            bw = self.bandwidth[from_dev][to_dev] if self.bandwidth else 0
            dur_ms = float(transfer_time_ms(output_size, bw)) if bw > 0 else 0.0
            task = event["task_name"]
            color = task_colors.get(task, "gray")
            xmax_ms = max(xmax_ms, start_ms + dur_ms + 50.0)
            for row in [device_index_to_comm_row[from_dev], device_index_to_comm_row[to_dev]]:
                ax.broken_barh([(start_ms, dur_ms)], (row - bar_height / 2, bar_height), facecolors=color, alpha=0.7)
                ax.text(start_ms + dur_ms / 2, row, f"{task} (comm)", ha="center", va="center", fontsize=7, color="white", clip_on=True)

        drawn_deadlines = set()
        for event in comp_events:
            deadline_ms = event.get("deadline_ms", -1)
            if deadline_ms is None or int(deadline_ms) <= 0 or float(deadline_ms) in drawn_deadlines:
                continue
            drawn_deadlines.add(float(deadline_ms))
            ax.axvline(float(deadline_ms), color="0.35", linestyle="--", linewidth=1.2, alpha=0.85, zorder=0)

        xmax_ms = float(int(math.ceil(max(xmax_ms, 100.0) / 100.0)) * 100)
        ax.set_xlim(0.0, xmax_ms)
        x_ticks = [float(v) for v in range(0, int(xmax_ms) + 1, 100)]
        ax.set_xticks(x_ticks)
        ax.xaxis.set_major_formatter(mticker.FuncFormatter(lambda value, _: f"{int(value)}"))
        ax.set_yticks(range(len(row_labels)))
        ax.set_yticklabels(row_labels)
        ax.set_xlabel("Time (ms)")
        ax.set_title("4-Jetson Device Scheduling (from runtime trace)")
        ax.grid(axis="x", linestyle="--", alpha=0.4)
        handles = [Line2D([0], [0], color=task_colors[t], lw=8, label=t) for t in tasks]
        handles.append(Line2D([0], [0], color="0.35", linestyle="--", lw=1.5, label="Deadline"))
        ax.legend(handles=handles, title="Task types", ncol=2)
        plt.tight_layout()
        plt.savefig(project_path("schedule_trace_4Jetson.png"), dpi=150)
        plt.close(fig)
    =}
}

reactor NetworkFabric4Jetson {
    input change
    input in_port0
    input in_port1
    input in_port2
    input in_port3
    input in_port4
    input in_port5
    logical action out_port0_trigger
    logical action out_port1_trigger
    logical action out_port2_trigger
    logical action out_port3_trigger
    logical action out_port4_trigger
    logical action out_port5_trigger
    output out_port0
    output out_port1
    output out_port2
    output out_port3
    output out_port4
    output out_port5

    state num_devices = 6
    state bandwidth
    state pending_packets
    state sender_available_ns

    reaction(startup) {=
        self.bandwidth = [[0] * self.num_devices for _ in range(self.num_devices)]
        self.pending_packets = [[] for _ in range(self.num_devices)]
        self.sender_available_ns = [0 for _ in range(self.num_devices)]
        comm_df = pd.read_csv(scenario_path("Bandwidth.csv"), index_col=0)
        comm_df.columns = comm_df.columns.str.strip()
        comm_df.index = comm_df.index.str.strip()
        comm_values = comm_df.values
        for i in range(self.num_devices):
            for j in range(self.num_devices):
                value = comm_values[i, j]
                if pd.isna(value) or (isinstance(value, float) and (value != value)):
                    sys.exit("Error: No NA is expected.")
                self.bandwidth[i][j] = int(value)
    =}

    reaction(in_port0, in_port1, in_port2, in_port3, in_port4, in_port5) -> out_port0_trigger, out_port1_trigger, out_port2_trigger, out_port3_trigger, out_port4_trigger, out_port5_trigger {=
        incoming_packets = []
        if in_port0.is_present:
            incoming_packets.append((0, in_port0.value))
        if in_port1.is_present:
            incoming_packets.append((1, in_port1.value))
        if in_port2.is_present:
            incoming_packets.append((2, in_port2.value))
        if in_port3.is_present:
            incoming_packets.append((3, in_port3.value))
        if in_port4.is_present:
            incoming_packets.append((4, in_port4.value))
        if in_port5.is_present:
            incoming_packets.append((5, in_port5.value))
        if len(incoming_packets) == 0:
            return

        for source_port, packet in incoming_packets:
            if not (isinstance(packet, dict) and "destination_device" in packet):
                continue
            destination_device = packet["destination_device"]
            payload_size = packet.get("input_size", packet.get("output_size", 0))
            bw = self.bandwidth[source_port][destination_device]
            transfer_delay_ms = transfer_time_ms(payload_size, bw) if bw > 0 else 0
            now_ns = int(lf.time.logical_elapsed())
            transfer_start_ns = max(now_ns, int(self.sender_available_ns[source_port]))
            ready_time_ns = transfer_start_ns + int(transfer_delay_ms) * 1000000
            self.sender_available_ns[source_port] = ready_time_ns
            self.pending_packets[destination_device].append((ready_time_ns, packet))
            self.pending_packets[destination_device].sort(key=lambda x: x[0])
            schedule_wait_ms = int(math.ceil((ready_time_ns - now_ns) / 1000000.0))

            if destination_device == 0:
                out_port0_trigger.schedule(MSEC(max(schedule_wait_ms, 0)))
            elif destination_device == 1:
                out_port1_trigger.schedule(MSEC(max(schedule_wait_ms, 0)))
            elif destination_device == 2:
                out_port2_trigger.schedule(MSEC(max(schedule_wait_ms, 0)))
            elif destination_device == 3:
                out_port3_trigger.schedule(MSEC(max(schedule_wait_ms, 0)))
            elif destination_device == 4:
                out_port4_trigger.schedule(MSEC(max(schedule_wait_ms, 0)))
            elif destination_device == 5:
                out_port5_trigger.schedule(MSEC(max(schedule_wait_ms, 0)))
    =}

    reaction(out_port0_trigger) -> out_port0, out_port0_trigger {=
        if len(self.pending_packets[0]) == 0:
            return
        current_ns = int(lf.time.logical_elapsed())
        self.pending_packets[0].sort(key=lambda x: x[0])
        next_ready_ns, _ = self.pending_packets[0][0]
        if next_ready_ns > current_ns:
            out_port0_trigger.schedule(MSEC(max(int(math.ceil((next_ready_ns - current_ns) / 1000000.0)), 1)))
            return
        _, packet = self.pending_packets[0].pop(0)
        out_port0.set(packet)
        if len(self.pending_packets[0]) > 0:
            out_port0_trigger.schedule(MSEC(max(int(math.ceil((self.pending_packets[0][0][0] - current_ns) / 1000000.0)), 0)))
    =}

    reaction(out_port1_trigger) -> out_port1, out_port1_trigger {=
        if len(self.pending_packets[1]) == 0:
            return
        current_ns = int(lf.time.logical_elapsed())
        self.pending_packets[1].sort(key=lambda x: x[0])
        next_ready_ns, _ = self.pending_packets[1][0]
        if next_ready_ns > current_ns:
            out_port1_trigger.schedule(MSEC(max(int(math.ceil((next_ready_ns - current_ns) / 1000000.0)), 1)))
            return
        _, packet = self.pending_packets[1].pop(0)
        out_port1.set(packet)
        if len(self.pending_packets[1]) > 0:
            out_port1_trigger.schedule(MSEC(max(int(math.ceil((self.pending_packets[1][0][0] - current_ns) / 1000000.0)), 0)))
    =}

    reaction(out_port2_trigger) -> out_port2, out_port2_trigger {=
        if len(self.pending_packets[2]) == 0:
            return
        current_ns = int(lf.time.logical_elapsed())
        self.pending_packets[2].sort(key=lambda x: x[0])
        next_ready_ns, _ = self.pending_packets[2][0]
        if next_ready_ns > current_ns:
            out_port2_trigger.schedule(MSEC(max(int(math.ceil((next_ready_ns - current_ns) / 1000000.0)), 1)))
            return
        _, packet = self.pending_packets[2].pop(0)
        out_port2.set(packet)
        if len(self.pending_packets[2]) > 0:
            out_port2_trigger.schedule(MSEC(max(int(math.ceil((self.pending_packets[2][0][0] - current_ns) / 1000000.0)), 0)))
    =}

    reaction(out_port3_trigger) -> out_port3, out_port3_trigger {=
        if len(self.pending_packets[3]) == 0:
            return
        current_ns = int(lf.time.logical_elapsed())
        self.pending_packets[3].sort(key=lambda x: x[0])
        next_ready_ns, _ = self.pending_packets[3][0]
        if next_ready_ns > current_ns:
            out_port3_trigger.schedule(MSEC(max(int(math.ceil((next_ready_ns - current_ns) / 1000000.0)), 1)))
            return
        _, packet = self.pending_packets[3].pop(0)
        out_port3.set(packet)
        if len(self.pending_packets[3]) > 0:
            out_port3_trigger.schedule(MSEC(max(int(math.ceil((self.pending_packets[3][0][0] - current_ns) / 1000000.0)), 0)))
    =}

    reaction(out_port4_trigger) -> out_port4, out_port4_trigger {=
        if len(self.pending_packets[4]) == 0:
            return
        current_ns = int(lf.time.logical_elapsed())
        self.pending_packets[4].sort(key=lambda x: x[0])
        next_ready_ns, _ = self.pending_packets[4][0]
        if next_ready_ns > current_ns:
            out_port4_trigger.schedule(MSEC(max(int(math.ceil((next_ready_ns - current_ns) / 1000000.0)), 1)))
            return
        _, packet = self.pending_packets[4].pop(0)
        out_port4.set(packet)
        if len(self.pending_packets[4]) > 0:
            out_port4_trigger.schedule(MSEC(max(int(math.ceil((self.pending_packets[4][0][0] - current_ns) / 1000000.0)), 0)))
    =}

    reaction(out_port5_trigger) -> out_port5, out_port5_trigger {=
        if len(self.pending_packets[5]) == 0:
            return
        current_ns = int(lf.time.logical_elapsed())
        self.pending_packets[5].sort(key=lambda x: x[0])
        next_ready_ns, _ = self.pending_packets[5][0]
        if next_ready_ns > current_ns:
            out_port5_trigger.schedule(MSEC(max(int(math.ceil((next_ready_ns - current_ns) / 1000000.0)), 1)))
            return
        _, packet = self.pending_packets[5].pop(0)
        out_port5.set(packet)
        if len(self.pending_packets[5]) > 0:
            out_port5_trigger.schedule(MSEC(max(int(math.ceil((self.pending_packets[5][0][0] - current_ns) / 1000000.0)), 0)))
    =}
}

main reactor(fast_enable = True) {
    s = new Scheduler4Jetson()
    r_1 = new ComputeDevice(device_index = 0, device_type_index = 0, device_name = "Jetson_1", bandwidth_csv_path = "data/sample_simulation_4Jetson/Bandwidth.csv", fast_enable = fast_enable)
    r_2 = new ComputeDevice(device_index = 1, device_type_index = 0, device_name = "Jetson_2", bandwidth_csv_path = "data/sample_simulation_4Jetson/Bandwidth.csv", fast_enable = fast_enable)
    r_3 = new ComputeDevice(device_index = 2, device_type_index = 0, device_name = "Jetson_3", bandwidth_csv_path = "data/sample_simulation_4Jetson/Bandwidth.csv", fast_enable = fast_enable)
    r_4 = new ComputeDevice(device_index = 3, device_type_index = 0, device_name = "Jetson_4", bandwidth_csv_path = "data/sample_simulation_4Jetson/Bandwidth.csv", fast_enable = fast_enable)
    r_5 = new ComputeDevice(device_index = 4, device_type_index = 1, device_name = "A6000", bandwidth_csv_path = "data/sample_simulation_4Jetson/Bandwidth.csv", fast_enable = fast_enable)
    r_6 = new ComputeDevice(device_index = 5, device_type_index = 2, device_name = "Blackwell", bandwidth_csv_path = "data/sample_simulation_4Jetson/Bandwidth.csv", fast_enable = fast_enable)
    n = new NetworkFabric4Jetson()
    t = new TaskSetSource()
    e = new EnvironmentUpdateDetector()
    o = new OutputVisualizer4Jetson()

    t.tasks, e.change -> s.tasks, s.change
    e.change -> n.change

    s.tasks_to_run -> r_1.tasks_to_run, r_2.tasks_to_run, r_3.tasks_to_run, r_4.tasks_to_run, r_5.tasks_to_run, r_6.tasks_to_run
    s.communication_map -> r_1.communication_map, r_2.communication_map, r_3.communication_map, r_4.communication_map, r_5.communication_map, r_6.communication_map

    r_1.out_port -> n.in_port0 after 1 ms
    r_2.out_port -> n.in_port1 after 1 ms
    r_3.out_port -> n.in_port2 after 1 ms
    r_4.out_port -> n.in_port3 after 1 ms
    r_5.out_port -> n.in_port4 after 1 ms
    r_6.out_port -> n.in_port5 after 1 ms

    n.out_port0 -> r_1.in_port after 1 ms
    n.out_port1 -> r_2.in_port after 1 ms
    n.out_port2 -> r_3.in_port after 1 ms
    n.out_port3 -> r_4.in_port after 1 ms
    n.out_port4 -> r_5.in_port after 1 ms
    n.out_port5 -> r_6.in_port after 1 ms

    r_1.final_output, r_2.final_output, r_3.final_output, r_4.final_output, r_5.final_output, r_6.final_output -> o.d0_output, o.d1_output, o.d2_output, o.d3_output, o.d4_output, o.d5_output
    r_1.trace_output -> o.d0_trace
    r_2.trace_output -> o.d1_trace
    r_3.trace_output -> o.d2_trace
    r_4.trace_output -> o.d3_trace
    r_5.trace_output -> o.d4_trace
    r_6.trace_output -> o.d5_trace
}
